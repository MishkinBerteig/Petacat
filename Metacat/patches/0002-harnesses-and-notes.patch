+#!/usr/bin/env python3
+"""
+Message-frequency profile, for the two dispatch optimizations.
+
+    docker compose exec metacat /metacat/docker/profile_messages.py -o /metacat/oracle-out
+
+Collects the data needed to decide:
+
+  #1  reorder record-case clauses hot-first. record-case compiles to a linear
+      eq? chain, so a message answered by the 92nd clause costs ~6.7x one
+      answered by the first. Needs: how often each message symbol is sent.
+
+  #2  replace (lambda msg ...) dispatchers with case-lambda. Objects still cons
+      a rest list on every send even though tell is now a macro. Needs: the
+      distribution of argument counts, to know which fixed arities to provide.
+
+tell is a macro (utilities.ss), so it cannot be wrapped at runtime. This copies
+the whole tree to a scratch directory, patches the macro there to count sends,
+and runs the sample against that copy. The repository is not touched, and the
+instrumented build is never used for the oracle numbers -- counting costs
+roughly 25%.
+"""
+
+import argparse
+import json
+import os
+import re
+import shutil
+import subprocess
+import sys
+import time
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from oracle import PROBLEMS, SPEED, ensure_display  # noqa: E402
+
+INSTR_DIR = "/tmp/instr"
+
+ORIGINAL_MACRO = """(extend-syntax (tell)
+  ((tell obj m arg ...)
+   (let* ((%tell-o% obj)
+	  (%tell-r% (%tell-o% %tell-o% m arg ...)))
+     (if (eq? %tell-r% 'invalid-message-indicator)
+       (report-error-and-halt (list %tell-o% m arg ...) %tell-o%)
+       %tell-r%))))"""
+
+COUNTING_MACRO = """(define *msg-counts* (make-eq-hashtable))
+(define *arity-counts* (make-eq-hashtable))
+(extend-syntax (tell)
+  ((tell obj m arg ...)
+   (let* ((%tell-o% obj)
+	  (%tell-r%
+	    (begin
+	      (hashtable-update! *msg-counts* m (lambda (v) (+ v 1)) 0)
+	      (hashtable-update! *arity-counts* (length '(arg ...))
+				 (lambda (v) (+ v 1)) 0)
+	      (%tell-o% %tell-o% m arg ...))))
+     (if (eq? %tell-r% 'invalid-message-indicator)
+       (report-error-and-halt (list %tell-o% m arg ...) %tell-o%)
+       %tell-r%))))"""
+
+
+def build_instrumented_tree(src_dir):
+    if os.path.exists(INSTR_DIR):
+        shutil.rmtree(INSTR_DIR)
+    os.makedirs(INSTR_DIR)
+    for fn in os.listdir(src_dir):
+        if fn.endswith(".ss") or fn.endswith(".txt"):
+            shutil.copy(os.path.join(src_dir, fn), os.path.join(INSTR_DIR, fn))
+
+    util = os.path.join(INSTR_DIR, "utilities.ss")
+    with open(util) as fh:
+        text = fh.read()
+    if ORIGINAL_MACRO not in text:
+        sys.exit("error: tell macro in utilities.ss does not match the expected "
+                 "text; update ORIGINAL_MACRO in this script")
+    with open(util, "w") as fh:
+        fh.write(text.replace(ORIGINAL_MACRO, COUNTING_MACRO))
+
+    # Loader pointing at the instrumented copy.
+    with open("/tmp/metacat-linux.ss") as fh:
+        loader = fh.read()
+    loader = re.sub(r'^\(define \*metacat-directory\* .*$',
+                    f'(define *metacat-directory* "{INSTR_DIR}/")',
+                    loader, flags=re.M)
+    path = "/tmp/instr-metacat.ss"
+    with open(path, "w") as fh:
+        fh.write(loader)
+    return path
+
+
+def worker_scheme(loader, results_path, runs_each, max_steps):
+    problems = "\n".join(
+        f"        (list '{i} '{m} '{t} \"{name}\")"
+        for name, i, m, t in PROBLEMS)
+    return f"""
+(load "{loader}")
+(setup)
+{SPEED}
+(with-output-to-file "{results_path}"
+  (lambda ()
+    (letrec
+      ((emit (lambda args (display (apply format args)) (write-char #\\newline)
+                     (flush-output-port (current-output-port))))
+       (problems (list
+{problems}))
+       (one-run
+         (lambda (p seed)
+           (tell *memory* 'clear)
+           (init-mcat (car p) (cadr p) (caddr p) #f seed)
+           (set! *break-time* {max_steps})
+           (call/cc (lambda (k)
+                      (set! suspend (lambda () (k 'answered)))
+                      (set! break   (lambda () (k 'capped)))
+                      (run-mcat))))))
+
+      ;; Discard everything counted during load and setup.
+      (hashtable-clear! *msg-counts*)
+      (hashtable-clear! *arity-counts*)
+
+      (let ((codelets 0) (runs 0) (t0 (real-time)))
+        (for-each
+          (lambda (p)
+            (let inner ((i 1))
+              (if (<= i {runs_each})
+                  (begin (one-run p i)
+                         (set! codelets (+ codelets *codelet-count*))
+                         (set! runs (+ runs 1))
+                         (inner (+ i 1))))))
+          problems)
+        (emit "META\\t~a\\t~a\\t~a" runs codelets (- (real-time) t0)))
+
+      (let-values (((keys vals) (hashtable-entries *msg-counts*)))
+        (vector-for-each (lambda (k v) (emit "MSG\\t~a\\t~a" k v)) keys vals))
+      (let-values (((keys vals) (hashtable-entries *arity-counts*)))
+        (vector-for-each (lambda (k v) (emit "ARITY\\t~a\\t~a" k v)) keys vals))))
+  'truncate)
+(exit)
+"""
+
+
+def count_clauses(src_dir):
+    """Clause count and clause order for each record-case dispatcher.
+
+    Parsed by paren depth rather than regex: a clause is a form at depth 1
+    inside (record-case ...), and its head is the message symbol.
+    """
+    out = {}
+    for fn in sorted(os.listdir(src_dir)):
+        if not fn.endswith(".ss"):
+            continue
+        text = open(os.path.join(src_dir, fn)).read()
+        for m in re.finditer(r"\(record-case\s", text):
+            i, depth, n = m.end(), 0, 0
+            clauses, buf, in_str, comment = [], "", False, False
+            while i < len(text):
+                c = text[i]
+                if comment:
+                    if c == "\n":
+                        comment = False
+                elif in_str:
+                    if c == '"' and text[i - 1] != "\\":
+                        in_str = False
+                elif c == ";":
+                    comment = True
+                elif c == '"':
+                    in_str = True
+                elif c == "(":
+                    depth += 1
+                    if depth == 1:
+                        buf = ""
+                elif c == ")":
+                    depth -= 1
+                    if depth == 0:
+                        head = buf.strip().split()[0] if buf.strip() else "?"
+                        clauses.append(head.strip("()"))
+                        n += 1
+                    elif depth < 0:
+                        break
+                elif depth == 1:
+                    buf += c
+                i += 1
+            if n > 20:
+                out.setdefault(fn, []).append(clauses)
+    return out
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("-o", "--out", default="/metacat/oracle-out")
+    ap.add_argument("--runs-each", type=int, default=8)
+    ap.add_argument("--max-steps", type=int, default=100_000)
+    ap.add_argument("--src", default="/metacat")
+    args = ap.parse_args()
+
+    os.makedirs(args.out, exist_ok=True)
+    print("building instrumented copy of the tree...", flush=True)
+    loader = build_instrumented_tree(args.src)
+
+    results = os.path.join(args.out, "messages.tsv")
+    script = os.path.join(args.out, "messages.ss")
+    with open(script, "w") as fh:
+        fh.write(worker_scheme(loader, results, args.runs_each, args.max_steps))
+
+    env = ensure_display(":250")
+    print(f"profiling {args.runs_each} runs x {len(PROBLEMS)} problems...", flush=True)
+    started = time.time()
+    proc = subprocess.run(["sh", "/usr/local/bin/swl", script],
+                          env=env, capture_output=True, text=True)
+
+    msgs, arity, meta = {}, {}, {}
+    if os.path.exists(results):
+        for line in open(results):
+            parts = line.rstrip("\n").split("\t")
+            if parts[0] == "MSG" and len(parts) == 3:
+                msgs[parts[1]] = int(parts[2])
+            elif parts[0] == "ARITY" and len(parts) == 3:
+                arity[int(parts[1])] = int(parts[2])
+            elif parts[0] == "META" and len(parts) == 4:
+                meta = {"runs": int(parts[1]), "codelets": int(parts[2]),
+                        "ms": int(parts[3])}
+    if not msgs:
+        print(f"FAILED: swl exit {proc.returncode}", file=sys.stderr)
+        print("\n".join((proc.stdout or "").splitlines()[-15:]), file=sys.stderr)
+        sys.exit(1)
+
+    total = sum(msgs.values())
+    payload = {
+        "meta": meta, "elapsed_s": round(time.time() - started, 1),
+        "total_sends": total,
+        "sends_per_codelet": round(total / max(meta.get("codelets", 1), 1), 1),
+        "messages": dict(sorted(msgs.items(), key=lambda kv: -kv[1])),
+        "arity": dict(sorted(arity.items())),
+        "dispatchers": count_clauses(args.src),
+    }
+    with open(os.path.join(args.out, "messages.json"), "w") as fh:
+        json.dump(payload, fh, indent=2)
+
+    print(f"\n{total:,} sends over {meta.get('codelets', 0):,} codelets "
+          f"({payload['sends_per_codelet']}/codelet)")
+    print("\ntop 20 messages:")
+    for k, v in list(payload["messages"].items())[:20]:
+        print(f"  {v:>10,}  {100*v/total:5.2f}%  {k}")
+    print("\nargument-count distribution:")
+    for k, v in payload["arity"].items():
+        print(f"  {k} args: {v:>10,}  ({100*v/total:5.2f}%)")
+
+
+if __name__ == "__main__":
+    main()
