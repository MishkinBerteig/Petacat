+# Metacat 1.2, running in its original Chez Scheme + SWL + Tcl/Tk toolchain.
+#
+#   docker compose up --build      first run (the build takes ~10 min)
+#   docker compose up -d           afterwards
+#   open http://localhost:6080/vnc.html?autoconnect=1&resize=scale
+#   docker compose down            stop
+#
+# The source directory is bind-mounted, so edits to the .ss files on the host
+# take effect on the next `docker compose restart` -- no rebuild needed.
+
+services:
+  metacat:
+    build:
+      context: ./docker
+      dockerfile: Dockerfile
+    image: metacat:1.2
+    container_name: metacat
+    # SWL only has x86 machine types and Chez 9.5.4 ships no arm64 boot file,
+    # so this is amd64 everywhere. On Apple Silicon it runs under Rosetta.
+    platform: linux/amd64
+    volumes:
+      # The Metacat source. Read-write so "Save commentary to file" works.
+      - .:/metacat
+    ports:
+      # Bound to loopback: the VNC server runs without a password, so it must
+      # not be reachable from the network.
+      - "127.0.0.1:6080:6080"   # noVNC in the browser
+      # 5901, not 5900: macOS Screen Sharing already owns 5900 on the host.
+      - "127.0.0.1:5901:5900"   # plain VNC, for a native client
+    environment:
+      SCREEN: 2880x1620x24
+    # Tk on a display this size wants more than the default 64MB of shared memory.
+    shm_size: "512m"
+    stdin_open: true
+    tty: true
+    # Deliberately not "unless-stopped": closing Metacat's Control Panel calls
+    # (exit), and an auto-restart would just bring it straight back.
+    restart: "no"
