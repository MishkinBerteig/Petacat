+#!/usr/bin/env python3
+"""
+Oracle benchmark: sample every problem to Good-Turing saturation.
+
+    docker compose exec metacat /metacat/docker/oracle.py
+
+For each of the 19 distinct problems, run until the Good-Turing missing-mass
+estimate f1/N falls in the target band, where f1 is the number of stopping
+states seen exactly once and N is the number of runs. f1/N estimates the
+probability that the next run reaches a state never seen before.
+
+    0.00006 < f1/N <= 0.0001
+
+The upper bound is the stop signal. The lower bound is not a stop condition --
+undershooting it is harmless to correctness, just wasted runs, so it is
+reported rather than enforced.
+
+Every run is its own session: Episodic Memory is cleared before each one, so
+runs are independent, a seed always reproduces its own answer, and the runs of
+a problem can therefore be split across processes with no interaction.
+
+SHARDING. Each problem is split across K worker processes covering disjoint,
+interleaved seed ranges (shard s takes indices s, s+K, s+2K, ...). f1 is a
+global statistic, so the shards cannot decide when to stop: each writes its
+per-state tallies after every chunk, and the coordinator merges them, evaluates
+the criterion, and signals the shards to finish by creating a stop file. A
+problem's wall clock is therefore its run count divided by K, not by 1.
+
+CHECKPOINT. A problem that reaches --checkpoint runs (default 50,000) without
+saturating stops there and reports rather than grinding on to MAX_RUNS. Resume
+it later with --resume, which carries the accumulated tallies forward and
+continues the seed sequence where it stopped, so nothing is recomputed.
+
+Recorded per problem: the frequency of every stopping state, the frequency of
+every codelet count reached at a stopping state, and the p50 set -- the
+smallest group of most-frequent states whose combined share reaches 50%.
+"""
+
+import argparse
+import json
+import os
+import shutil
+import subprocess
+import sys
+import time
+from collections import Counter
+from concurrent.futures import ThreadPoolExecutor
+
+# ---- Good-Turing criterion --------------------------------------------------
+BATCH = 1_000                       # runs between saturation checks
+MIN_RUNS = 3_000                    # floor before any stop is allowed
+MIN_RUNS_IF_NO_SINGLETONS = 10_000  # 1/TARGET_UPPER; f1==0 cannot distinguish
+MAX_RUNS = 200_000                  # backstop for a problem that never saturates
+MAX_STEPS = 100_000                 # per-run codelet cap
+TARGET_UPPER = 1e-4
+TARGET_LOWER = 6e-5
+CHECKPOINT = 50_000                 # stop and report rather than grind to MAX_RUNS
+
+PROBLEMS = [
+    ("misc4",       "a",     "b",       "z"),
+    ("fig5.7",      "aabc",  "aabd",    "ijkk"),
+    ("misc3",       "abc",   "aabbcc",  "kkjjii"),
+    ("misc5",       "abc",   "abd",     "glz"),
+    ("misc2",       "abc",   "abd",     "ijk"),
+    ("run1",        "abc",   "abd",     "mrrjjj"),
+    ("run4",        "abc",   "abd",     "xyz"),
+    ("misc1",       "abc",   "cba",     "mrrjjj"),
+    ("fig5.4-top",  "eeqee", "qeeq",    "xxixx"),
+    ("eqe-baaab",   "eqe",   "qeq",     "abbba"),
+    ("run6",        "eqe",   "qeq",     "abbbc"),
+    ("run3",        "rst",   "rsu",     "xyz"),
+    ("run2",        "xqc",   "xqd",     "mrrjjj"),
+    ("copy1",       "ab",    "c",       "ab"),
+    ("copy2",       "bc",    "d",       "bc"),
+    ("copy3",       "xy",    "z",       "xy"),
+    ("copy4",       "zy",    "x",       "zy"),
+    ("copy5",       "aabb",  "cc",      "aabb"),
+    ("copy6",       "abc",   "d",       "abc"),
+]
+
+SPEED = """
+(set! %flash-pause% 0) (set! %num-of-flashes% 0) (set! %snag-pause% 0)
+(set! %text-scroll-pause% 0) (set! %codelet-highlight-pause% 0)
+(set! %highlight-last-codelet% #f) (set! %verbose% #f)
+(set! %slipnet-graphics% #f) (set! %coderack-graphics% #f)
+(set! %workspace-graphics% #f)
+;; *memory-window* stays real: it supplies Episodic Memory icon geometry and
+;; init-mcat dies without it once memory is non-empty.
+(let ((null-window (lambda msg 'done)))
+  (set! *themespace-window* null-window)
+  (set! *comment-window* null-window)
+  (set! *trace-window* null-window)
+  (set! *temperature-window* null-window)
+  (set! *EEG-window* null-window)
+  (set! *workspace-window* null-window))
+"""
+
+
+def shard_scheme(initial, modified, target, out_path, snap_path, stop_path,
+                 shard, nshards, start_index, chunk, max_steps):
+    """One shard: run its slice of the seed sequence until told to stop.
+
+    Emits a TICK line per chunk with its per-state tallies (few tens of states,
+    so this is cheap) and, once stopped, the full codelet histogram.
+    """
+    return f"""
+;; Performance mode: plain Chez, no SWL, no Tk, no X display, no (setup).
+;; headless.ss supplies every GUI dependency as a no-op, so there is nothing
+;; here to switch off and no window to leak canvas items.
+(define *metacat-directory* "/metacat/")
+(load "/metacat/metacat-headless.ss")
+(with-output-to-file "{out_path}"
+  (lambda ()
+    (letrec
+      ((emit (lambda args
+               (display (apply format args))
+               ;; write-char, not (newline): Metacat rebinds newline to the port
+               ;; captured at load time (syntactic-sugar.ss:32).
+               (write-char #\\newline)
+               (flush-output-port (current-output-port))))
+       (states '())                       ;; alist (state . count)
+       (hist (make-eqv-hashtable))        ;; codelet count -> frequency
+       (runs 0)
+       (bump (lambda (state)
+               (let ((hit (assoc state states)))
+                 (if hit
+                     (set-cdr! hit (+ (cdr hit) 1))
+                     (set! states (cons (cons state 1) states))))))
+       (one-run
+         (lambda (seed)
+           ;; Every run is its own session -- no Episodic Memory carries over.
+           (tell *memory* 'clear)
+           (init-mcat '{initial} '{modified} '{target} #f seed)
+           (set! *break-time* {max_steps})
+           (let* ((outcome (call/cc (lambda (k)
+                                      (set! suspend (lambda () (k 'answered)))
+                                      (set! break   (lambda () (k 'capped)))
+                                      (run-mcat))))
+                  (answers (tell *memory* 'get-answers)))
+             (hashtable-update! hist *codelet-count* (lambda (v) (+ v 1)) 0)
+             (set! runs (+ runs 1))
+             (bump (cond
+                     ((not (null? answers))
+                      (tell (car answers) 'get-answer-print-name))
+                     ((eq? outcome 'capped) "*CAP*")
+                     (else "*NONE*"))))))
+       (tally (lambda ()
+                (let loop ((s states) (acc ""))
+                  (if (null? s)
+                      acc
+                      (loop (cdr s)
+                            (string-append acc (if (string=? acc "") "" ",")
+                                           (caar s) ":"
+                                           (number->string (cdar s))))))))
+       (snapshot
+         (lambda ()
+           (let ((p (open-output-file "{snap_path}" 'truncate)))
+             (display (format "RUNS\\t~a" runs) p) (write-char #\\newline p)
+             (display (format "TICK\\t~a\\t~a" runs (tally)) p)
+             (write-char #\\newline p)
+             (let-values (((ks vs) (hashtable-entries hist)))
+               (vector-for-each
+                 (lambda (k v)
+                   (display (format "HIST\\t~a\\t~a" k v) p)
+                   (write-char #\\newline p))
+                 ks vs))
+             (close-output-port p)))))
+
+      (let loop ()
+        (let inner ((i 0))
+          (if (< i {chunk})
+              (begin
+                ;; seed = start + shard + runs*nshards + 1. runs is this
+                ;; shard's completed count, so the shards interleave over the
+                ;; global seed sequence and never collide.
+                (one-run (+ {start_index} {shard} (* runs {nshards}) 1))
+                (inner (+ i 1)))))
+        (emit "TICK\\t~a\\t~a" runs (tally))
+        ;; Rewrite the full snapshot every chunk. A shard can be killed at any
+        ;; point -- by the coordinator's grace timer or by hand -- and a
+        ;; histogram written only at exit would be lost, which silently biases
+        ;; the codelet distribution by dropping exactly the slowest shards.
+        (snapshot)
+        (if (not (file-exists? "{stop_path}"))
+            (loop)))
+
+      (snapshot)
+      (emit "DONE\\t~a" runs)))
+  'truncate)
+(exit)
+"""
+
+
+def ensure_display(display):
+    env = dict(os.environ, DISPLAY=display)
+    if subprocess.run(["xdpyinfo"], env=env, capture_output=True).returncode == 0:
+        return env
+    lock = f"/tmp/.X{display.lstrip(':')}-lock"
+    if os.path.exists(lock):
+        try:
+            os.remove(lock)
+        except OSError:
+            pass
+    subprocess.Popen(["Xvfb", display, "-screen", "0", "640x480x8", "-nolisten", "tcp"],
+                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+    for _ in range(60):
+        if subprocess.run(["xdpyinfo"], env=env, capture_output=True).returncode == 0:
+            return env
+        time.sleep(0.5)
+    raise RuntimeError(f"Xvfb never came up on {display}")
+
+
+def read_shard(path):
+    """Latest TICK tallies, plus histogram and completion once the shard exits."""
+    states, hist, runs, done = Counter(), Counter(), 0, False
+    if not os.path.exists(path):
+        return states, hist, runs, done
+    try:
+        with open(path) as fh:
+            for line in fh:
+                parts = line.rstrip("\n").split("\t")
+                if parts[0] == "TICK" and len(parts) == 3:
+                    runs = int(parts[1])
+                    states = Counter()
+                    if parts[2]:
+                        for item in parts[2].split(","):
+                            state, _, count = item.rpartition(":")
+                            states[state] = int(count)
+                elif parts[0] == "HIST" and len(parts) == 3:
+                    hist[int(parts[1])] += int(parts[2])
+                elif parts[0] == "DONE":
+                    done = True
+    except (OSError, ValueError):
+        pass
+    return states, hist, runs, done
+
+
+def decide(n, f1, min_runs, checkpoint, max_runs):
+    """The stopping rule, in exact integer arithmetic (f1/n <= 1e-4)."""
+    if f1 > 0 and n >= min_runs and f1 * 10_000 <= n:
+        return "saturated"
+    if f1 == 0 and n >= MIN_RUNS_IF_NO_SINGLETONS:
+        return "no_singletons"
+    if n >= max_runs:
+        return "max_runs"
+    if n >= checkpoint:
+        return "checkpoint"
+    return None
+
+
+def run_problem(job):
+    idx, problem, outdir, cfg, prior = job
+    name, initial, modified, target = problem
+    workdir = os.path.join(outdir, name)
+    shutil.rmtree(workdir, ignore_errors=True)
+    os.makedirs(workdir, exist_ok=True)
+    stop_path = os.path.join(workdir, "STOP")
+
+    k = cfg["shards"]
+    chunk = max(1, cfg["batch"] // k)
+    start_index = prior.get("n", 0)
+
+    procs, envs = [], []
+    for s in range(k):
+        script = os.path.join(workdir, f"shard{s}.ss")
+        out = os.path.join(workdir, f"shard{s}.tsv")
+        with open(script, "w") as fh:
+            snap = os.path.join(workdir, f"shard{s}.snap")
+            fh.write(shard_scheme(initial, modified, target, out, snap, stop_path,
+                                  s, k, start_index, chunk, cfg["max_steps"]))
+        # Plain Chez: no swl (so no shebang problem) and no display. DISPLAY is
+        # cleared so nothing can quietly reach for an X server.
+        env = dict(os.environ)
+        env.pop("DISPLAY", None)
+        envs.append(env)
+        # Capture rather than discard: Metacat reports a bad message send with
+        # a printf and then (reset)s, which kills the shard silently. Sending
+        # that to DEVNULL is how five copy* problems ended early in the first
+        # full run with nothing to show for it.
+        log = open(os.path.join(workdir, f"shard{s}.log"), "w")
+        procs.append(subprocess.Popen(["scheme", "-q", script],
+                                      env=env, stdout=log, stderr=log))
+
+    started = time.time()
+    reason, last_report, stopped_at = None, 0, None
+    prior_states = Counter(prior.get("states", {}))
+    while True:
+        time.sleep(2)
+        merged = Counter(prior_states)
+        n = start_index
+        for s in range(k):
+            st, _, runs, _ = read_shard(os.path.join(workdir, f"shard{s}.tsv"))
+            merged.update(st)
+            n += runs
+        f1 = sum(1 for v in merged.values() if v == 1)
+        if reason is None:
+            reason = decide(n, f1, cfg["min_runs"], cfg["checkpoint"], cfg["max_runs"])
+            if reason:
+                open(stop_path, "w").close()
+                stopped_at = time.time()
+        if n - last_report >= 5000:
+            last_report = n
+            print(f"    {name:<12} n={n:<7} f1={f1:<4} states={len(merged)}",
+                  flush=True)
+        if all(p.poll() is not None for p in procs):
+            break
+        # Shards check the stop file once per chunk, so they should exit within
+        # a chunk. This only covers a shard that has wedged.
+        if stopped_at and time.time() - stopped_at > 900:
+            for p in procs:
+                p.kill()
+            break
+
+    # int(k): the histogram is keyed by codelet count, but JSON object keys are
+    # always strings, so a --resume brings them back as str and every later
+    # arithmetic on them (codelet_stats, sorted()) breaks.
+    prior_hist = Counter({int(k): v for k, v in prior.get("hist", {}).items()})
+    states, hist, n = Counter(prior_states), prior_hist, start_index
+    for s in range(k):
+        # .snap, not .tsv: rewritten every chunk, so it survives a killed shard
+        st, hi, runs, _ = read_shard(os.path.join(workdir, f"shard{s}.snap"))
+        states.update(st)
+        hist.update(hi)
+        n += runs
+    f1 = sum(1 for v in states.values() if v == 1)
+    reason = reason or decide(n, f1, cfg["min_runs"], cfg["checkpoint"],
+                              cfg["max_runs"]) or "shards_exited"
+
+    return {
+        "name": name, "problem": list(problem), "n": n, "f1": f1,
+        "ratio": (f1 / n) if n else None,
+        "overshot": bool(n and f1 / n <= TARGET_LOWER),
+        "stop_reason": reason, "wall_s": round(time.time() - started, 1),
+        "shards": k, "distinct_states": len(states),
+        "states": dict(states.most_common()),
+        "hist": {str(kk): vv for kk, vv in sorted(hist.items())},
+        "codelet_stats": codelet_stats(hist),
+        "p50": p50_set(states, n),
+    }
+
+
+def codelet_stats(hist):
+    if not hist:
+        return {}
+    values = sorted(hist.items())
+    total = sum(hist.values())
+    out, acc = {}, 0
+    marks = {0.5: "p50", 0.9: "p90", 0.99: "p99"}
+    for codelets, count in values:
+        acc += count
+        for q, label in list(marks.items()):
+            if acc >= total * q:
+                out.setdefault(label, codelets)
+    out["min"] = values[0][0]
+    out["max"] = values[-1][0]
+    out["mean"] = round(sum(c * n for c, n in values) / total, 1)
+    out["total_codelets"] = sum(c * n for c, n in values)
+    return out
+
+
+def p50_set(states, n):
+    acc, chosen = 0, []
+    for state, count in states.most_common():
+        chosen.append({"state": state, "count": count, "share": count / n})
+        acc += count
+        if acc >= n / 2:
+            break
+    return chosen
+
+
