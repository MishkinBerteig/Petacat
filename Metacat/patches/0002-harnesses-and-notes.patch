+++ b/docker/solve.sh
@@ -0,0 +1,151 @@
+#!/bin/bash
+#
+# Run one Metacat problem without the GUI.
+#
+#   solve.sh <initial> <modified> <target> [--seed N] [--max N] [--answer STR]
+#
+#   docker compose exec metacat /metacat/docker/solve.sh abc abd xyz
+#   docker compose exec metacat /metacat/docker/solve.sh abc abd xyz --seed 42
+#   docker compose exec metacat /metacat/docker/solve.sh abc abd mrrjjj --seed 42
+#   docker compose exec metacat /metacat/docker/solve.sh abc cba pqrs --answer sqrp
+#
+# Each invocation is a fresh Metacat process with an empty Episodic Memory, so
+# runs are independent. Expect ~60s: Metacat takes ~45s to load and (setup)
+# before a single codelet runs.
+#
+# Metacat cannot run without an X display even with the GUI unused --
+# answers.ss talks to *comment-window* unconditionally and constants.ss builds
+# Tk fonts at load time -- so this uses its own Xvfb, separate from the one the
+# GUI is on.
+
+set -euo pipefail
+
+SOLVE_DISPLAY="${SOLVE_DISPLAY:-:98}"
+MAX_CODELETS=8000
+SEED=""
+ANSWER=""
+
+usage() {
+    sed -n '3,18p' "$0" | sed 's/^# \?//'
+    exit "${1:-0}"
+}
+
+[ $# -lt 3 ] && usage 1
+INITIAL="$1"; MODIFIED="$2"; TARGET="$3"; shift 3
+
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --seed)   SEED="$2";        shift 2 ;;
+        --max)    MAX_CODELETS="$2"; shift 2 ;;
+        --answer) ANSWER="$2";      shift 2 ;;
+        -h|--help) usage 0 ;;
+        *) echo "unknown option: $1" >&2; usage 1 ;;
+    esac
+done
+
+# Chez's random-seed wants a positive integer below 2^32.
+if [ -z "$SEED" ]; then
+    SEED=$(( $(od -An -N4 -tu4 /dev/urandom | tr -d ' ') % 4294967294 + 1 ))
+fi
+
+if [ -n "$ANSWER" ]; then
+    JUSTIFY="#t"; ANSWER_SYM="'${ANSWER}"; SHOWN="${ANSWER}   (justify mode)"
+else
+    JUSTIFY="#f"; ANSWER_SYM="#f";         SHOWN="?"
+fi
+
+# Its own X display, started once and reused across calls.
+if ! DISPLAY="$SOLVE_DISPLAY" xdpyinfo >/dev/null 2>&1; then
+    rm -f "/tmp/.X${SOLVE_DISPLAY#:}-lock"
+    Xvfb "$SOLVE_DISPLAY" -screen 0 1280x1024x24 -nolisten tcp >/dev/null 2>&1 &
+    for _ in $(seq 1 40); do
+        DISPLAY="$SOLVE_DISPLAY" xdpyinfo >/dev/null 2>&1 && break
+        sleep 0.5
+    done
+fi
+
+RUN=$(mktemp /tmp/metacat-solve-XXXXXX.ss)
+OUT=$(mktemp /tmp/metacat-solve-XXXXXX.txt)
+LOG=$(mktemp /tmp/metacat-solve-XXXXXX.log)
+trap 'rm -f "$RUN" "$OUT" "$LOG"' EXIT
+
+cat > "$RUN" <<EOF
+(load "/tmp/metacat-linux.ss")
+(setup)
+;; Speed: 26 -> ~2500 codelets/sec, same answers. Must follow (setup) --
+;; %flash-pause%, %snag-pause% and %num-of-flashes% have no define anywhere and
+;; only exist once the Speed slider is built (gui.ss:413-426). Zeroing
+;; %flash-pause% short-circuits the flash animation at general-graphics.ss:289.
+;; %workspace-graphics% #f depends on the guard added at run.ss:166-176.
+;; The null windows cover themes.ss/trace.ss/memory.ss/answers.ss, which draw
+;; unconditionally; no engine code reads what they return.
+(set! %flash-pause% 0)
+(set! %num-of-flashes% 0)
+(set! %snag-pause% 0)
+(set! %text-scroll-pause% 0)
+(set! %codelet-highlight-pause% 0)
+(set! %highlight-last-codelet% #f)
+(set! %verbose% #f)
+(set! %slipnet-graphics% #f)
+(set! %coderack-graphics% #f)
+(set! %workspace-graphics% #f)
+;; *memory-window* is deliberately NOT stubbed: it is what gives Episodic Memory
+;; descriptions their icon geometry, and without it the next init-mcat dies once
+;; memory is non-empty (run.ss:204-205). It costs almost nothing.
+(let ((null-window (lambda msg 'done)))
+  (set! *themespace-window* null-window)
+  (set! *comment-window* null-window)
+  (set! *trace-window* null-window)
+  (set! *temperature-window* null-window)
+  (set! *EEG-window* null-window)
+  (set! *workspace-window* null-window))
+(set! %justify-mode% ${JUSTIFY})
+(with-output-to-file "${OUT}"
+  (lambda ()
+    ;; NOT printf: Metacat rebinds printf to the output port captured when
+    ;; syntactic-sugar.ss loaded (syntactic-sugar.ss:27), so it ignores
+    ;; with-output-to-file and would write to the real stdout instead.
+    (let ((emit (lambda args (display (apply format args)))))
+      (guard (e (#t (emit "error: ~a ~a~%"
+                          (condition-message e) (condition-irritants e))))
+        (init-mcat '${INITIAL} '${MODIFIED} '${TARGET} ${ANSWER_SYM} ${SEED})
+        ;; run-mcat stops by calling (break) once *codelet-count* reaches this.
+        (set! *break-time* ${MAX_CODELETS})
+        ;; Reuse run-mcat itself rather than reimplementing its loop -- it does
+        ;; more per step than step-mcat (slipnode unclamping, coderack refill),
+        ;; and skipping any of it changes what Metacat concludes.
+        ;; Its two exits, (suspend) on an answer and (break) on the cap,
+        ;; normally drop into the REPL; send them here instead.
+        (let ((outcome (call/cc (lambda (k)
+                                  (set! suspend (lambda () (k 'answered)))
+                                  (set! break   (lambda () (k 'hit-max)))
+                                  (run-mcat)))))
+          (emit "problem:   ~a -> ~a; ~a -> ${SHOWN}~%"
+                '${INITIAL} '${MODIFIED} '${TARGET})
+          (emit "seed:      ~a~%" ${SEED})
+          (emit "codelets:  ~a~%" *codelet-count*)
+          (emit "outcome:   ~a~%" outcome))
+        (for-each
+          (lambda (a)
+            (emit "answer:    ~a   (quality ~a, temperature ~a)~%"
+              (tell a 'get-answer-print-name)
+              (tell a 'get-quality)
+              (tell a 'get-temperature)))
+          (tell *memory* 'get-answers))
+        (for-each
+          (lambda (s) (emit "snag:      ~a~%" (tell s 'print-name)))
+          (tell *memory* 'get-snags)))))
+  'truncate)
+(exit)
+EOF
+
+DISPLAY="$SOLVE_DISPLAY" swl "$RUN" >"$LOG" 2>&1 || true
+cat "$OUT"
+
+# Metacat's own printf goes to the real stdout, so a bad `tell` prints its
+# "Ooops: bad message" there rather than into the result file.
+if [ ! -s "$OUT" ] || grep -q '^error:' "$OUT"; then
+    echo "--- swl output ---" >&2
+    tail -20 "$LOG" >&2
+    exit 1
+fi
