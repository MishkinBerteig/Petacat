+#!/usr/bin/env python3
+"""Render the oracle benchmark results as markdown.
+
+    docker compose exec metacat /metacat/docker/make_oracle_report.py \
+        -o /metacat/ORACLE-BENCHMARK.md
+
+Reads oracle-out/oracle.json plus any per-problem override file (misc3 was
+paused and accepted by hand, so it carries its own record). Emits the whole
+report so the numbers cannot drift in transcription.
+"""
+
+import argparse
+import json
