+# Metacat 1.2 — Chez Scheme 9.5.4 + SWL 1.3 + Tcl/Tk 8.6 on Debian, with the
+# GUI exported over VNC/noVNC.
+#
+# Why linux/amd64: SWL's configure.ss only has cases for x86 machine types
+# (a6le, i3le, ...) and Chez 9.5.4 ships no arm64 boot file, so there is no
+# arm64 target to build. On Apple Silicon this runs under Rosetta and is fast.
+#
+# Chez 9.5.4 and the patched SWL are the exact pair the Metacat author
+# distributes; SWL 1.3 was patched by Frank Sinapsi to build against modern
+# Chez. Stock SWL 1.3 does not compile here.
+
+########################  builder  ########################
+FROM debian:bookworm-slim AS builder
+
+ARG CHEZ_URL=https://science.slc.edu/jmarshall/metacat/ChezScheme-9.5.4.tgz
+ARG SWL_URL=https://science.slc.edu/jmarshall/metacat/swl1.3-src-patched-linux.tgz
+
+RUN apt-get update && apt-get install -y --no-install-recommends \
+        build-essential ca-certificates curl \
+        libncurses-dev libx11-dev uuid-dev \
+        tcl8.6 tcl8.6-dev tk8.6 tk8.6-dev \
+    && rm -rf /var/lib/apt/lists/*
+
+# SWL's configure.ss expects the Tcl/Tk script libraries at /usr/lib/tcl8.6 and
+# /usr/lib/tk8.6; Debian ships them under /usr/share/tcltk. It also shells out
+# to a bare `tclsh` to discover the Tcl version.
+RUN ln -sfn /usr/share/tcltk/tcl8.6 /usr/lib/tcl8.6 \
+ && ln -sfn /usr/share/tcltk/tk8.6  /usr/lib/tk8.6 \
+ && ln -sfn /usr/bin/tclsh8.6       /usr/bin/tclsh
+
+WORKDIR /src
+
+# Chez Scheme 9.5.4. Machine type a6le (64-bit Linux, non-threaded) is what
+# SWL's configure.ss knows and what SWL's own thread system expects.
+RUN curl -fsSL "$CHEZ_URL" | tar xz \
+ && cd ChezScheme \
+ && ./configure --machine=a6le --installprefix=/usr/local \
+ && make \
+ && make install
+
+# SWL 1.3. `make` must run under full Chez (`scheme`), not Petite — the
+# top-level Makefile refuses to rebuild the libraries with Petite.
+RUN curl -fsSL "$SWL_URL" | tar xz \
+ && cd swl1.3 \
+ && make \
+ && make install
+
+########################  runtime  ########################
+FROM debian:bookworm-slim
+
+RUN apt-get update && apt-get install -y --no-install-recommends \
+        tcl8.6 tk8.6 libncurses6 libuuid1 \
+        xvfb x11vnc websockify novnc fluxbox wmctrl xdotool \
+        x11-utils x11-xserver-utils procps \
+        xfonts-base xfonts-75dpi xfonts-100dpi xfonts-scalable fonts-urw-base35 \
+    && rm -rf /var/lib/apt/lists/*
+
+# The swl launcher script bakes in TCL_LIBRARY=/usr/lib/tcl8.6 and
+# TK_LIBRARY=/usr/lib/tk8.6, so the runtime stage needs the same symlinks.
+RUN ln -sfn /usr/share/tcltk/tcl8.6 /usr/lib/tcl8.6 \
+ && ln -sfn /usr/share/tcltk/tk8.6  /usr/lib/tk8.6
+
+COPY --from=builder /usr/local /usr/local
+
+COPY entrypoint.sh /usr/local/bin/metacat-entrypoint
+RUN chmod +x /usr/local/bin/metacat-entrypoint
+
+ENV DISPLAY=:99 \
+    SCREEN=2880x1620x24 \
+    VNC_PORT=5900 \
+    NOVNC_PORT=6080 \
+    METACAT_DIR=/metacat \
+    TCLTK_VERSION=8.6
+
+EXPOSE 5900 6080
+WORKDIR /metacat
+ENTRYPOINT ["/usr/local/bin/metacat-entrypoint"]
