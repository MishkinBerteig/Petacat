+         "fig5.4-top", "eqe-baaab", "run6", "run3", "run2",
+         "copy1", "copy2", "copy3", "copy4", "copy5", "copy6"]
+
+TRIPLE = {
+    "misc4": ("a", "b", "z"), "fig5.7": ("aabc", "aabd", "ijkk"),
+    "misc3": ("abc", "aabbcc", "kkjjii"), "misc5": ("abc", "abd", "glz"),
+    "misc2": ("abc", "abd", "ijk"), "run1": ("abc", "abd", "mrrjjj"),
+    "run4": ("abc", "abd", "xyz"), "misc1": ("abc", "cba", "mrrjjj"),
+    "fig5.4-top": ("eeqee", "qeeq", "xxixx"), "eqe-baaab": ("eqe", "qeq", "abbba"),
+    "run6": ("eqe", "qeq", "abbbc"), "run3": ("rst", "rsu", "xyz"),
+    "run2": ("xqc", "xqd", "mrrjjj"), "copy1": ("ab", "c", "ab"),
+    "copy2": ("bc", "d", "bc"), "copy3": ("xy", "z", "xy"),
+    "copy4": ("zy", "x", "zy"), "copy5": ("aabb", "cc", "aabb"),
+    "copy6": ("abc", "d", "abc"),
+}
