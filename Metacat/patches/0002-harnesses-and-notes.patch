+#!/usr/bin/env python3
+"""
+Derive the four comparison sets from the raw oracle data.
+
+    docker/make_derived_sets.py
+
+Reads   oracle/raw/single-runs.json     every stopping state of 374,500 single runs
+        oracle/raw/episodes.json.gz     every run of 9,500 eight-run episodes
+
+Writes  oracle/derived/single-run-sets.json
+        oracle/derived/single-run-p50.json
+        oracle/derived/convergence-sets.json
+        oracle/derived/convergence-p50.json
+
+Raw data is what the reference implementation emitted and is never edited.
+Everything here is recomputable from it, and these four files are what a
+comparison run actually loads. See ORACLE-USAGE.md for the protocol.
+
+THE TWO KINDS OF SET
+
+  single-run set   the stopping state of one run started from a fresh Episodic
+                   Memory -- the answer, or *NONE* (gave up) or *CAP* (hit the
+                   codelet ceiling).
+
+  convergence set  the CONVERGENCE ANSWER of one episode: the last of its eight
+                   runs that actually produced an answer. *NONE* and *CAP* runs
+                   are skipped looking backwards, since they are not answers.
+                   An episode that never answered contributes nothing and is
+                   counted separately; that happens once in 9,500 episodes.
+
+A p50 set is the fewest most-frequent members whose shares reach 50%, the same
+construction oracle.py uses. Each member carries the probability it is absent
+from a 100-try sample by chance alone, which is the false-alarm rate of the
+"a p50 member went missing" check.
+"""
+
+import argparse
+import gzip
+import json
+import os
+
+ANSWERLESS = {"*NONE*", "*CAP*"}
+N_TEST = 100  # tries per problem in a comparison run
+
+HERE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+RAW = os.path.join(HERE, "oracle", "raw")
+DERIVED = os.path.join(HERE, "oracle", "derived")
+
+
+def p50_set(counts, total):
+    chosen, cum = [], 0
+    for member, c in sorted(counts.items(), key=lambda kv: (-kv[1], kv[0])):
+        share = c / total
+        chosen.append({
+            "member": member,
+            "count": c,
+            "share": round(share, 6),
+            f"absence_probability_at_n{N_TEST}": round((1 - share) ** N_TEST, 12),
+        })
+        cum += c
+        if cum / total >= 0.5:
+            break
+    return chosen
+
+
+def as_set(counts, total):
+    return {m: {"count": c, "share": round(c / total, 6)}
+            for m, c in sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))}
+
+
+def gt(counts, total):
+    f1 = sum(1 for v in counts.values() if v == 1)
+    return f1, (round(f1 / total, 6) if total else None)
+
+
+def convergence_answer(runs):
+    for r in reversed(runs):
+        if r["state"] not in ANSWERLESS:
+            return r["state"]
+    return None
+
+
+def load_episodes():
+    path = os.path.join(RAW, "episodes.json")
+    if os.path.exists(path):
+        return json.load(open(path))
+    with gzip.open(path + ".gz", "rt") as fh:
+        return json.load(fh)
+
+
+def write(name, payload):
+    out = os.path.join(DERIVED, name)
+    with open(out, "w") as fh:
+        json.dump(payload, fh, indent=2)
+    return out
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--quiet", action="store_true")
+    args = ap.parse_args()
+    os.makedirs(DERIVED, exist_ok=True)
+
+    single = json.load(open(os.path.join(RAW, "single-runs.json")))
+    episodes = load_episodes()
+
+    # ---- single runs -----------------------------------------------------
+    s_sets, s_p50 = [], []
+    for r in single["results"]:
+        counts, n = r["states"], r["n"]
+        f1, ratio = gt(counts, n)
+        common = {"name": r["name"], "problem": r["problem"], "n": n}
+        s_sets.append({**common, "stop_reason": r["stop_reason"],
+                       "distinct": len(counts), "f1": f1, "f1_over_n": ratio,
+                       "set": as_set(counts, n)})
+        s_p50.append({**common, "p50": p50_set(counts, n)})
+
+    # ---- episodes --------------------------------------------------------
+    c_sets, c_p50 = [], []
+    for r in episodes["results"]:
+        counts, never = {}, 0
+        for s in r["sequences"]:
+            a = convergence_answer(s["runs"])
+            if a is None:
+                never += 1
+            else:
+                counts[a] = counts.get(a, 0) + 1
+        n = sum(counts.values())
+        f1, ratio = gt(counts, n)
+        common = {"name": r["name"], "problem": r["problem"],
+                  "episodes": len(r["sequences"]),
+                  "episodes_with_an_answer": n,
+                  "episodes_never_answering": never,
+                  "runs_per_episode": r["runs_per_episode"]}
+        c_sets.append({**common, "distinct": len(counts), "f1": f1,
+                       "f1_over_n": ratio, "set": as_set(counts, n)})
+        c_p50.append({**common, "p50": p50_set(counts, n)})
+
+    note_single = ("A run's stopping state, from a fresh Episodic Memory. "
+                   "Sampled to Good-Turing saturation (f1_over_n <= 1e-4), so a "
+                   "member outside this set is very unlikely to be undersampling.")
+    note_conv = ("An episode's convergence answer: its last run that produced an "
+                 "answer, skipping *NONE* and *CAP*. Shares and f1_over_n are "
+                 "over episodes that answered. DELIBERATELY NOT saturated -- see "
+                 "ORACLE-USAGE.md.")
+
+    paths = [
+        write("single-run-sets.json",
+              {"source": "oracle/raw/single-runs.json", "definition": note_single,
+               "results": s_sets}),
+        write("single-run-p50.json",
+              {"source": "oracle/raw/single-runs.json", "definition": note_single,
+               "tries_per_problem": N_TEST, "results": s_p50}),
+        write("convergence-sets.json",
+              {"source": "oracle/raw/episodes.json.gz", "definition": note_conv,
+               "results": c_sets}),
+        write("convergence-p50.json",
+              {"source": "oracle/raw/episodes.json.gz", "definition": note_conv,
+               "tries_per_problem": N_TEST, "results": c_p50}),
+    ]
+
+    if args.quiet:
+        return
+    for p in paths:
+        print(f"  wrote {os.path.relpath(p, HERE)}")
+    print(f"\n{'problem':12s} | {'single runs':>22s} | {'episodes':>30s}")
+    print(f"{'':12s} | {'distinct  f1/n  p50':>22s} | "
+          f"{'distinct  f1/n  p50':>30s}")
+    print("-" * 72)
+    for a, b, ap_, bp in zip(s_sets, c_sets, s_p50, c_p50):
+        print(f"{a['name']:12s} | {a['distinct']:8d} {a['f1_over_n']:7.5f} "
+              f"{len(ap_['p50']):4d}  | {b['distinct']:8d} {b['f1_over_n']:7.4f} "
+              f"{len(bp['p50']):4d}   "
+              + ", ".join(e["member"] for e in bp["p50"]))
+
+
+if __name__ == "__main__":
+    main()
