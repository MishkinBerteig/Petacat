+#!/usr/bin/env python3
+"""
+Render episodes.json for manual inspection.
+
+    docker/episode_report.py episode-out/episodes.json [problem ...]
+
+This deliberately does NOT commit to a statistic. The point of the pilot is to
+look at the sequences and decide afterwards what analysis the full run deserves,
+so this prints the raw progressions first and only then a few candidate
+descriptive measures, each labelled with what would undermine it.
+"""
+
+import json
+import sys
+from collections import Counter
+
+
+def episode_line(runs):
+    """One episode as a readable arrow sequence."""
+    return " -> ".join(r["state"] for r in runs)
+
+
+def novelty_curve(sequences):
+    """Fraction of episodes whose run i produced a state not seen earlier in it."""
+    if not sequences:
+        return []
+    width = max(len(s["runs"]) for s in sequences)
+    out = []
+    for i in range(width):
+        seen_new, total = 0, 0
+        for s in sequences:
+            if i >= len(s["runs"]):
+                continue
+            total += 1
+            earlier = {r["state"] for r in s["runs"][:i]}
+            if s["runs"][i]["state"] not in earlier:
+                seen_new += 1
+        out.append(seen_new / total if total else 0.0)
+    return out
+
+
+def mean_by_index(sequences, key, skip_missing=None):
+    width = max((len(s["runs"]) for s in sequences), default=0)
+    out = []
+    for i in range(width):
+        vals = [s["runs"][i][key] for s in sequences
+                if i < len(s["runs"])
+                and (skip_missing is None or s["runs"][i][key] != skip_missing)]
+        out.append(sum(vals) / len(vals) if vals else None)
+    return out
+
+
+def fmt(xs, spec="{:.2f}"):
+    return " ".join("  --  " if x is None else spec.format(x) for x in xs)
+
+
+def main():
+    path = sys.argv[1]
+    wanted = set(sys.argv[2:])
+    data = json.load(open(path))
+    p = data["params"]
+    print(f"episodes={p['episodes']} runs/episode={p['runs']} "
+          f"start_seed={p['start_seed']} max_steps={p['max_steps']}\n")
+
+    for res in data["results"]:
+        if wanted and res["name"] not in wanted:
+            continue
+        seqs = res["sequences"]
+        _, initial, modified, target = res["problem"]
+        print("=" * 78)
+        print(f"{res['name']}   {initial} -> {modified} ; {target} -> ?   "
+              f"{res['episodes_complete']}/{res['episodes_requested']} episodes"
+              f"{'   ERRORS: ' + str(len(res['errors'])) if res['errors'] else ''}")
+        print("=" * 78)
+        if res["errors"]:
+            for e in res["errors"][:5]:
+                print(f"  ! {e}")
+
+        print("\n-- sequences (the thing to actually look at) --")
+        for s in seqs:
+            print(f"  ep{s['episode']:<3} seed {s['start_seed']:<6} "
+                  f"{episode_line(s['runs'])}")
+
+        if not seqs:
+            continue
+
+        print("\n-- distinct states per episode --")
+        counts = [len({r['state'] for r in s['runs']}) for s in seqs]
+        print(f"  {counts}   mean {sum(counts)/len(counts):.2f} "
+              f"of {p['runs']} runs")
+
+        print("\n-- by run index (position within the episode) --")
+        idx = range(max(len(s["runs"]) for s in seqs))
+        print("  index      " + " ".join(f"{i:^6}" for i in idx))
+        print("  novel      " + fmt(novelty_curve(seqs)))
+        print("  codelets   " + fmt(mean_by_index(seqs, "codelets"), "{:6.0f}"))
+        print("  quality    " + fmt(mean_by_index(seqs, "quality", -1.0), "{:6.1f}"))
+        print("  temp       " + fmt(mean_by_index(seqs, "temperature"), "{:6.1f}"))
+        print("  #answers   " + fmt(mean_by_index(seqs, "memory_answers"), "{:6.2f}"))
+        print("  #snags     " + fmt(mean_by_index(seqs, "memory_snags"), "{:6.2f}"))
+
+        print("\n  novel = share of episodes whose run at this index produced a")
+        print("  state not already seen in that episode. It must fall by")
+        print("  construction -- answers.ss:982 refuses to report an answer")
+        print("  already in memory -- so the question is not whether it falls but")
+        print("  whether it falls faster than sampling without replacement from")
+        print("  the single-run distribution would predict. That comparison needs")
+        print("  the single-run oracle, and is deliberately not made here.")
+
+        print("\n-- state frequency, first run vs last run --")
+        first = Counter(s["runs"][0]["state"] for s in seqs)
+        last = Counter(s["runs"][-1]["state"] for s in seqs)
+        for st in sorted(set(first) | set(last),
+                         key=lambda k: -(first[k] + last[k])):
+            print(f"  {st:<14} first {first[st]:>4}   last {last[st]:>4}")
+
+        print("\n-- remindings (activation of a stored answer after a later run) --")
+        strong = [(s["episode"], r["i"], a["answer"], a["activation"])
+                  for s in seqs for r in s["runs"]
+                  for a in r["activations"]
+                  if 0 < a["activation"] < 100]
+        if not strong:
+            print("  none: no stored answer was ever activated by a later one.")
+            print("  With %distance-threshold% = 5 (memory.ss:486) that means")
+            print("  every pair of answers was at distance >= 5.")
+        else:
+            for ep, i, ans, act in strong[:25]:
+                print(f"  ep{ep:<3} run{i:<3} {ans:<12} activation {act:.0f}")
+            if len(strong) > 25:
+                print(f"  ... {len(strong) - 25} more")
+        print()
+
+
+if __name__ == "__main__":
+    main()
