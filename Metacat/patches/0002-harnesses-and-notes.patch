+#!/bin/bash
+#
+# Metacat container entrypoint.
+#
+# Ordering here is deliberate and load-bearing:
+#
+#     Xvfb  ->  Metacat  ->  wait for (setup)  ->  window manager  ->  layout
+#
+# Metacat creates fifteen toplevel windows in one synchronous burst inside
+# (setup), and it deadlocks partway through if a reparenting window manager is
+# already running -- openbox, fluxbox and twm were each tried and each hung it
+# after two windows. With no WM present, (setup) completes in about 30 seconds.
+#
+# Starting the WM afterwards is safe: it adopts the already-mapped windows.
+# The layout then has to be applied by hand, because Metacat sets window
+# *sizes* only and leaves placement entirely to the WM (constants.ss:43,
+# set-window-size-defaults) -- without this every window sits at the origin.
+
+set -euo pipefail
+
+DISPLAY="${DISPLAY:-:99}"
+SCREEN="${SCREEN:-2880x1620x24}"
+VNC_PORT="${VNC_PORT:-5900}"
+NOVNC_PORT="${NOVNC_PORT:-6080}"
+METACAT_DIR="${METACAT_DIR:-/metacat}"
+TCLTK_VERSION="${TCLTK_VERSION:-8.6}"
+export DISPLAY
+
+say() { printf '[metacat] %s\n' "$*"; }
+
+if [ ! -f "${METACAT_DIR}/metacat.ss" ]; then
+    say "ERROR: no metacat.ss under ${METACAT_DIR}."
+    say "Mount the Metacat source there (docker-compose.yml does this already)."
+    exit 1
+fi
+
+# ---------------------------------------------------------------- X server ---
+# A container that is restarted rather than recreated keeps /tmp, and a stale
+# lock makes Xvfb refuse to start.
+rm -f "/tmp/.X${DISPLAY#:}-lock"
+rm -rf /tmp/.X11-unix
+
+say "starting Xvfb on ${DISPLAY} at ${SCREEN}"
+Xvfb "$DISPLAY" -screen 0 "$SCREEN" -nolisten tcp >/tmp/xvfb.log 2>&1 &
+
+for _ in $(seq 1 40); do
+    xdpyinfo >/dev/null 2>&1 && break
+    sleep 0.5
+done
+xdpyinfo >/dev/null 2>&1 || { say "ERROR: Xvfb never came up"; cat /tmp/xvfb.log; exit 1; }
+xsetroot -solid grey25 2>/dev/null || true
+
+# ------------------------------------------------------------------- remote ---
+say "starting x11vnc on :${VNC_PORT} and noVNC on :${NOVNC_PORT}"
+x11vnc -display "$DISPLAY" -forever -shared -nopw -quiet \
+       -rfbport "$VNC_PORT" >/tmp/x11vnc.log 2>&1 &
+websockify --web /usr/share/novnc "$NOVNC_PORT" "localhost:${VNC_PORT}" \
+       >/tmp/websockify.log 2>&1 &
+
+# ------------------------------------------------- Linux-flavoured metacat.ss ---
+# The checked-in metacat.ss is configured for the macOS host. Rather than make
+# the repository file container-specific, derive a Linux copy at start-up. It
+# only overrides the four configuration lines; everything else, including the
+# load order, comes from the mounted file. *metacat-directory* still points at
+# the mount, so all 43 other .ss files load from there.
+GEN=/tmp/metacat-linux.ss
+sed -e "s|^(define \*platform\* .*|(define *platform* 'linux)|" \
+    -e "s|^(define \*metacat-directory\* .*|(define *metacat-directory* \"${METACAT_DIR}/\")|" \
+    -e "s|^(define \*file-dialog-directory\* .*|(define *file-dialog-directory* \"${METACAT_DIR}/\")|" \
+    -e "s|^(define \*tcl/tk-version\* .*|(define *tcl/tk-version* ${TCLTK_VERSION})|" \
+    "${METACAT_DIR}/metacat.ss" > "$GEN"
+
+cat > /tmp/metacat-start.ss <<EOF
+(load "${GEN}")
+(setup)
+EOF
+
+# Loaded by swl purely so that it reaches (new-repl 'default) and opens the GUI
+# repl window; the real work is typed into that repl below. See the comment on
+# drive_repl for why Metacat cannot simply be loaded here.
+printf ';; intentionally empty -- see docker/entrypoint.sh\n' > /tmp/metacat-boot.ss
+
+# ------------------------------------------- window manager + layout, deferred ---
+# Titles are exactly as Metacat sets them, so wmctrl -F (exact match) is safe.
+# Coordinates are frame positions on a 2880x1620 screen; fluxbox adds a ~20px
+# titlebar, which the vertical gaps below already allow for.
+#
+# EEG and Logo are in the table but will not move: Metacat leaves both unmapped
+# at start-up, so no window manager adopts them. They get placed by fluxbox if
+# and when you show the EEG from the Control Panel's Windows menu.
+layout() {
+    while read -r x y title; do
+        wmctrl -F -r "$title" -e "0,${x},${y},-1,-1" 2>/dev/null || true
+    done <<'LAYOUT'
+0 0 Workspace
+810 0 Slipnet
+810 380 Top Themes
+810 570 Bottom Themes
+1470 0 Vertical Themes
+1640 0 Coderack
+1880 0 Temperature
+1960 0 Episodic Memory
+2240 0 Commentary
+0 660 Temporal Trace
+0 800 EEG
+0 990 Metacat Control Panel
+500 990 Logo
+1030 800 Interaction window
+1900 660 repl
+LAYOUT
+}
+
+# Metacat must be loaded by *typing into SWL's repl window*, not by passing it
+# to swl on the command line. (setup) records the thread it runs on as
+# *repl-thread* (setup.ss:70), and every Control Panel action injects the run
+# into that thread with (thread-break *repl-thread* ...) (gui.ss:762,772).
+# Loaded as a script argument, (setup) runs on the script-loading thread rather
+# than the repl thread, and clicking Go dies with
+#     Exception: attempt to apply non-procedure #f
+# So drive the repl the way a human would, which is also what README.txt says.
+drive_repl() {
+    local win=""
+    for _ in $(seq 1 120); do
+        win=$(xdotool search --name '^repl$' 2>/dev/null | head -1)
+        [ -n "$win" ] && break
+        sleep 1
+    done
+    if [ -z "$win" ]; then
+        say "ERROR: SWL's repl window never appeared"
+        return 1
+    fi
+
+    # No WM is running yet, so put the window somewhere known and click into
+    # its text area -- synthetic focus alone is not reliable with Tk.
+    xdotool windowmove "$win" 100 100
+    xdotool windowraise "$win"
+    sleep 2
+    xdotool mousemove 400 300 click 1
+    sleep 1
+    say "loading Metacat into the repl (this takes ~45s)"
+    xdotool type --delay 40 '(load "/tmp/metacat-start.ss")'
+    xdotool key Return
+}
+
+(
+    drive_repl || true
+
+    # The Control Panel is the last window (setup) creates, so its appearance
+    # means the burst is over and a WM can safely be introduced.
+    for _ in $(seq 1 120); do
+        if xwininfo -root -children 2>/dev/null | grep -q "Metacat Control Panel"; then
+            break
+        fi
+        sleep 2
+    done
+
+    if ! xwininfo -root -children 2>/dev/null | grep -q "Metacat Control Panel"; then
+        say "WARNING: Control Panel never appeared; starting the WM anyway"
+    else
+        say "(setup) finished; starting fluxbox"
+    fi
+
+    mkdir -p /root/.fluxbox
+    # Without this fluxbox's style calls fbsetbg, which finds no wallpaper
+    # setter installed and pops a modal xmessage over the Temporal Trace.
+    printf 'background: none\n' > /root/.fluxbox/overlay
+    printf 'session.screen0.rootCommand: xsetroot -solid grey25\n' \
+        > /root/.fluxbox/init
+
+    fluxbox >/tmp/fluxbox.log 2>&1 &
+
+    sleep 6
+    layout
+    # Belt and braces: fbsetbg is invoked from the style, so kill the dialog if
+    # it appeared anyway.
+    pkill -x xmessage 2>/dev/null || true
+    say "window layout applied -- open http://localhost:${NOVNC_PORT}/vnc.html"
+) &
+
+# ------------------------------------------------------------------- Metacat ---
+# swl loads its arguments and then calls (new-repl 'default), which is what
+# opens the GUI repl window. It needs at least one file argument to take that
+# path, hence the empty metacat-boot.ss; the background job above then types
+# the real load into the repl it opens.
+say "starting SWL"
+cd "$METACAT_DIR"
+exec swl /tmp/metacat-boot.ss </dev/null
