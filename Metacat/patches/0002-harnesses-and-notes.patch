+#!/usr/bin/env python3
+"""
+Check that no object is sent a message it cannot answer.
+
+    docker compose exec metacat /metacat/docker/check_messages.py
+    docker compose exec metacat /metacat/docker/check_messages.py --enumerate
+
+`tell` on an unanswerable message reaches report-error-and-halt
+(utilities.ss), which prints `Ooops: bad message ...` and (reset)s -- silently
+abandoning the run. Under SWL that line went to the GUI console and the run just
+vanished, which is why several of these survived for years. Run this after any
+change to the engine, and after any change to how it is driven.
+
+TWO MODES
+
+  --verify (default)   Run every problem with the real reporter. Any Ooops, or
+                       any run that fails to complete, is a failure. This is the
+                       regression check.
+
+  --enumerate          Replace report-error-and-halt with a recorder that
+                       returns #f, so a run limps on instead of dying and
+                       reveals further bad messages in the same pass. Use this
+                       when --verify has found one and you want to see what else
+                       is behind it.
+
+                       Returning #f corrupts the computation, so a run usually
+                       dies of a downstream type error ("append: #f is not a
+                       proper list") before reaching the next genuine bad send.
+                       Expect to fix, re-run, and repeat: finding the nine
+                       workspace-string methods in CODE-FIXES.md took three
+                       passes. Answers produced in this mode are meaningless.
+
+EPISODES, NOT JUST RUNS. Both modes run sessions with Episodic Memory carried
+forward, because that is where the interesting failures are. Five of the nine
+methods in CODE-FIXES.md need two snags in one run, which 374,500 single runs
+never produced but episodes reach easily -- once memory suppresses a problem's
+answers, later runs grind to the codelet ceiling and pile up snags.
+"""
+
+import argparse
+import os
+import subprocess
+import sys
+from collections import Counter
+from concurrent.futures import ThreadPoolExecutor
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from episodes import PROBLEMS  # noqa: E402  the one definition of the 19 problems
+
+RECORDER = """
+;; Record and carry on, instead of print-and-(reset).
+(set! report-error-and-halt
+  (lambda (message object)
+    (printf "BADMSG\\t~a\\t~a~n" (2nd message) (tell object 'object-type))
+    #f))
+"""
+
+SCRIPT = """
+(define *metacat-directory* "/metacat/")
+(load "/metacat/metacat-headless.ss")
+{recorder}
+(let loop ((ep 0))
+  (if (< ep {episodes})
+    (begin
+      ;; A fresh session per episode; memory persists WITHIN one.
+      (tell *memory* 'clear)
+      (let inner ((i 0))
+        (if (< i {runs})
+          (begin
+            (init-mcat '{initial} '{modified} '{target} #f
+              (+ {start_seed} (* ep {runs}) i))
+            (set! *break-time* {max_steps})
+            (call/cc (lambda (k)
+                       (set! suspend (lambda () (k 'answered)))
+                       (set! break   (lambda () (k 'capped)))
+                       (run-mcat)))
+            (printf "RUN~n")
+            (inner (+ i 1)))))
+      (loop (+ ep 1)))))
+(printf "SWEEPDONE~n")
+(exit)
+"""
+
+
+def run(job):
+    name, initial, modified, target, cfg = job
+    path = os.path.join(cfg["workdir"], f"check_{name}.ss")
+    with open(path, "w") as fh:
+        fh.write(SCRIPT.format(
+            recorder=RECORDER if cfg["enumerate"] else "",
+            initial=initial, modified=modified, target=target,
+            episodes=cfg["episodes"], runs=cfg["runs"],
+            start_seed=cfg["start_seed"], max_steps=cfg["max_steps"]))
+    env = dict(os.environ)
+    env.pop("DISPLAY", None)  # plain Chez; nothing may reach for an X server
+    proc = subprocess.run(["scheme", "-q", path], env=env,
+                          capture_output=True, text=True)
+    blob = proc.stdout + proc.stderr
+    bad = Counter()
+    for ln in blob.splitlines():
+        if ln.startswith("BADMSG"):
+            p = ln.split("\t")
+            if len(p) >= 3:
+                bad[(p[1], p[2])] += 1
+    return {
+        "name": name,
+        "runs": sum(1 for ln in proc.stdout.splitlines() if ln == "RUN"),
+        "expected": cfg["episodes"] * cfg["runs"],
+        "finished": "SWEEPDONE" in proc.stdout,
+        "oops": [ln for ln in blob.splitlines() if "Ooops" in ln],
+        "bad": bad,
+        "tail": blob[-400:],
+    }
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--enumerate", action="store_true",
+                    help="record bad sends and carry on, instead of dying")
+    ap.add_argument("-e", "--episodes", type=int, default=30)
+    ap.add_argument("-r", "--runs", type=int, default=8)
+    ap.add_argument("--start-seed", type=int, default=200_000,
+                    help="clear of both committed data sets by default")
+    ap.add_argument("--max-steps", type=int, default=100_000)
+    ap.add_argument("-j", "--jobs", type=int, default=10)
+    ap.add_argument("-w", "--workdir", default="/metacat/oracle/work/check")
+    ap.add_argument("--only")
+    args = ap.parse_args()
+
+    os.makedirs(args.workdir, exist_ok=True)
+    problems = PROBLEMS
+    if args.only:
+        wanted = set(args.only.split(","))
+        problems = [p for p in PROBLEMS if p[0] in wanted]
+
+    cfg = dict(episodes=args.episodes, runs=args.runs, max_steps=args.max_steps,
+               start_seed=args.start_seed, workdir=args.workdir,
+               enumerate=args.enumerate)
+    mode = "enumerate" if args.enumerate else "verify"
+    total = len(problems) * args.episodes * args.runs
+    print(f"{mode}: {len(problems)} problems x {args.episodes} episodes x "
+          f"{args.runs} runs = {total} runs, max_steps={args.max_steps}\n",
+          flush=True)
+
+    results, all_bad = [], Counter()
+    with ThreadPoolExecutor(max_workers=args.jobs) as pool:
+        for res in pool.map(run, [(*p, cfg) for p in problems]):
+            results.append(res)
+            all_bad.update(res["bad"])
+            ok = res["finished"] and res["runs"] == res["expected"] and not res["oops"]
+            flag = ""
+            if res["oops"]:
+                flag = f"  {len(res['oops'])} Ooops"
+            elif res["bad"]:
+                flag = f"  {sum(res['bad'].values())} bad sends"
+            elif not res["finished"]:
+                flag = "  DID NOT FINISH"
+            print(f"  {'ok  ' if ok else 'FAIL'} {res['name']:<12} "
+                  f"{res['runs']}/{res['expected']} runs{flag}", flush=True)
+
+    if args.enumerate:
+        print("\n=== every message an object could not answer ===")
+        for (msg, otype), n in all_bad.most_common():
+            print(f"  {n:>7}  {msg:<28} -> {otype}")
+        if not all_bad:
+            print("  none")
+        # Enumerate mode always corrupts state, so a non-zero exit here would be
+        # meaningless. It reports; it does not judge.
+        return 0
+
+    broken = [r for r in results
+              if r["oops"] or not r["finished"] or r["runs"] != r["expected"]]
+    if broken:
+        print(f"\n{len(broken)} problem(s) failed:")
+        for r in broken:
+            print(f"--- {r['name']}")
+            for o in r["oops"][:3]:
+                print(f"    {o}")
+            if not r["oops"]:
+                print(f"    {r['tail'].strip()[-300:]}")
+        print("\nRe-run with --enumerate to see everything behind the first failure.")
+        return 1
+    print(f"\nall {len(results)} problems clean: no bad messages, every run completed")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
