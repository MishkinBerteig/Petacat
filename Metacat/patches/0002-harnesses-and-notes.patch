+#!/usr/bin/env python3
+"""
+Run many Metacat problems in one warmed-up process, grouped into sessions that
+share an Episodic Memory.
+
+    docker compose exec metacat /metacat/docker/batch.py spec.json -o /metacat/out
+
+Metacat costs ~45s to load and (setup). This pays that once and then runs every
+problem in the batch, so a thousand runs cost the startup once rather than a
+thousand times.
+
+A *session* is a run of problems that share one Episodic Memory. Memory is
+cleared at the start of each session and persists between runs inside it. That
+distinction is the point of the tool: Metacat will not re-find an answer it
+already holds in memory (help.txt:29), so the second run of a problem inside a
+session explores differently from the first, while the first run of every
+session reproduces exactly.
+
+Input JSON, either explicit:
+
+    {
+      "max_codelets": 8000,
+      "sessions": [
+        {"name": "xyz baseline",
+         "runs": [
+           {"initial": "abc", "modified": "abd", "target": "xyz", "seed": 42},
+           {"initial": "abc", "modified": "abd", "target": "xyz", "seed": 42}
+         ]}
+      ]
+    }
+
+or generated, for scale:
+
+    {
+      "max_codelets": 8000,
+      "generate": {
+        "sessions": 500,
+        "runs_per_session": 3,
+        "problems": [{"initial": "abc", "modified": "abd", "target": "xyz"},
+                     {"initial": "abc", "modified": "abd", "target": "mrrjjj"}],
+        "seed_start": 1000,
+        "seed_step": 1
+      }
+    }
+
+Problems are cycled across the runs of a session. Seeds advance across the whole
+batch, so every run gets a distinct one. A run may carry "answer" for justify
+mode and its own "max_codelets".
+
+Outputs, in the directory given by -o:
+    results.tsv    raw, written and flushed as each run finishes
+    report.csv     session, run, seed, problem, codelets, final temp, result
+    results.jsonl  the same rows as JSON objects
+"""
+
+import argparse
+import csv
+import json
+import os
+import re
+import shutil
+import subprocess
+import sys
+import time
+
+# The TSV schema, in the order emit-row writes them.
+FIELDS = [
+    "session", "session_name", "run", "seed",
+    "initial", "modified", "target", "given_answer",
+    "codelets", "final_temp", "outcome", "result", "quality",
+]
+
+# report.csv adds a rendered "problem" column in front of the raw parts.
+CSV_FIELDS = (
+    FIELDS[:4] + ["problem"] + FIELDS[4:]
+)
+
+# Letter-strings become Scheme symbols and session names become Scheme strings;
+# neither may carry anything that would end the token early.
+SYMBOL_RE = re.compile(r"^[a-z]+$")
+
+
+def clean_name(name):
+    return re.sub(r'[\t\r\n"\\]', " ", str(name)).strip() or "session"
+
+
+def check_string(value, field):
+    value = str(value).lower()
+    if not SYMBOL_RE.match(value):
+        sys.exit(f"error: {field} must be lowercase letters only, got {value!r}")
+    return value
+
+
+def build_runs(spec):
+    """Flatten the spec into (session_index, session_name, run_index, run) rows."""
+    default_max = int(spec.get("max_codelets", 8000))
+    rows = []
+
+    if "generate" in spec and "sessions" in spec:
+        sys.exit('error: give either "sessions" or "generate", not both')
+
+    if "generate" in spec:
+        g = spec["generate"]
+        problems = g["problems"]
+        if not problems:
+            sys.exit('error: generate.problems is empty')
+        n_sessions = int(g["sessions"])
+        per_session = int(g.get("runs_per_session", 1))
+        seed = int(g.get("seed_start", 1))
+        step = int(g.get("seed_step", 1))
+        for s in range(n_sessions):
+            for r in range(per_session):
+                p = dict(problems[r % len(problems)])
+                p.setdefault("seed", seed)
+                seed += step
+                rows.append((s, g.get("name_prefix", "session") + f"-{s}", r, p))
+    else:
+        for s, session in enumerate(spec.get("sessions", [])):
+            name = clean_name(session.get("name", f"session-{s}"))
+            for r, run in enumerate(session.get("runs", [])):
+                rows.append((s, name, r, dict(run)))
+
+    if not rows:
+        sys.exit("error: batch contains no runs")
+
+    out = []
+    for s, name, r, run in rows:
+        initial = check_string(run["initial"], "initial")
+        modified = check_string(run["modified"], "modified")
+        target = check_string(run["target"], "target")
+        answer = run.get("answer")
+        answer = check_string(answer, "answer") if answer else None
+        seed = int(run.get("seed", 1))
+        if not 1 <= seed <= 4294967295:
+            sys.exit(f"error: seed {seed} out of range 1..4294967295")
+        out.append({
+            "session": s, "session_name": clean_name(name), "run": r,
+            "initial": initial, "modified": modified, "target": target,
+            "answer": answer, "seed": seed,
+            "max_codelets": int(run.get("max_codelets", default_max)),
+        })
+    return out
+
+
+def generate_scheme(rows, results_path):
+    """One Scheme program: load once, then walk the batch."""
+    literals = []
+    for x in rows:
+        literals.append(
+            "({s} \"{name}\" {r} {i} {m} {t} {a} {seed} {maxc})".format(
+                s=x["session"], name=x["session_name"], r=x["run"],
+                i=x["initial"], m=x["modified"], t=x["target"],
+                # Bare, not quoted: the whole *batch* list is already quoted, so
+                # a leading ' here would read as the list (quote sqrp).
+                a=x["answer"] if x["answer"] else "#f",
+                seed=x["seed"], maxc=x["max_codelets"],
+            )
+        )
+    batch_literals = "\n".join("      " + line for line in literals)
+    return f"""
+(load "/tmp/metacat-linux.ss")
+(setup)
+
+;; ---- speed: 26 -> ~2500 codelets/sec, same answers -------------------------
+;; All of this MUST follow (setup). %flash-pause%, %snag-pause% and
+;; %num-of-flashes% have no define anywhere in the tree: they spring into
+;; existence when make-control-panel builds the Speed slider and fires
+;; speed-slider-action (gui.ss:413-426). Before (setup) they are unbound.
+;;
+;; 1. Pauses. The slider cannot reach these values -- its non-100 branch floors
+;;    at (max 2), (max 10), (max 250). Zeroing %flash-pause% short-circuits the
+;;    whole flash animation at general-graphics.ss:289. 26 -> 298 c/s alone.
+(set! %flash-pause% 0)
+(set! %num-of-flashes% 0)
+(set! %snag-pause% 0)              ;; a 2500ms wall on every snag by default
+(set! %text-scroll-pause% 0)
+(set! %codelet-highlight-pause% 0)
+(set! %highlight-last-codelet% #f)
+(set! %verbose% #f)
+
+;; 2. Drawing. 298 -> 960 c/s for the first two; the third needs the guard
+;;    added at run.ss:166-176, without which the run dies at codelet 100.
+;;    960 -> ~1990 c/s.
+(set! %slipnet-graphics% #f)
+(set! %coderack-graphics% #f)
+(set! %workspace-graphics% #f)
+
+;; 3. Null windows. themes.ss, trace.ss, memory.ss and answers.ss talk to these
+;;    unconditionally -- no %...-graphics% flag guards them -- and themes.ss
+;;    redraws all 75 themes every update cycle. No engine code reads what they
+;;    return. ~1990 -> ~2500 c/s.
+;;    Cost: the commentary is discarded. Nothing here captures it anyway.
+;;
+;;    *memory-window* is deliberately NOT stubbed. Episodic Memory descriptions
+;;    get their icon geometry from memory-graphics.ss via 'add-memory-icon; stub
+;;    that out and the geometry stays #f, and the next init-mcat dies in
+;;    'clear-activations / 'unhighlight-all-answers (run.ss:204-205) the moment
+;;    memory is non-empty -- i.e. on the second run of any session. It is
+;;    touched only when an answer or snag is stored, so it costs almost nothing.
+(let ((null-window (lambda msg 'done)))
+  (set! *themespace-window* null-window)
+  (set! *comment-window* null-window)
+  (set! *trace-window* null-window)
+  (set! *temperature-window* null-window)
+  (set! *EEG-window* null-window)
+  (set! *workspace-window* null-window))
+
+;; Cognition is unchanged, checked against the unaccelerated settings:
+;; abc->abd;xyz seed 42 -> dyz, 1364 codelets, temperature 17
+;; abc->abd;mrrjjj seed 42 -> mrrkkk, 964, 32
+;; abc->abd;ijk seed 958012227 -> ijl, 439, 16
+;; ---------------------------------------------------------------------------
+
+;; Everything below lives inside one with-output-to-file and one letrec, on
+;; purpose: top-level (define ...)s after (setup) writing to an explicitly
+;; opened port hang the run. Bisected against an otherwise identical script.
+;; The mechanism is not understood; this shape works, so do not "tidy" it.
+
+(with-output-to-file "{results_path}"
+  (lambda ()
+    (letrec
+      ((emit-row
+         (lambda fields
+           (let loop ((f fields) (first? #t))
+             (if (null? f)
+                 ;; (write-char #\\newline), never (newline): Metacat rebinds
+                 ;; BOTH printf and newline to the port captured when
+                 ;; syntactic-sugar.ss loaded (lines 27 and 32), so (newline)
+                 ;; silently writes to SWL's console and every row here would
+                 ;; land on one enormous line.
+                 (begin (write-char #\\newline)
+                        (flush-output-port (current-output-port)))
+                 (begin
+                   (if (not first?) (write-char #\\tab))
+                   ;; display, not printf, for the same reason.
+                   (display (car f))
+                   (loop (cdr f) #f))))))
+       (run-one
+         (lambda (sidx sname ridx initial modified target answer seed maxc)
+           (set! %justify-mode% (if answer #t #f))
+           (init-mcat initial modified target answer seed)
+           (set! *break-time* maxc)
+           (let* ((n-before (length (tell *memory* 'get-answers)))
+                  ;; Reuse run-mcat; its exits, (suspend) on an answer and
+                  ;; (break) on the codelet cap, normally drop into the REPL.
+                  ;; Rebound per run: each needs its own escape continuation.
+                  (outcome (call/cc (lambda (k)
+                                      (set! suspend (lambda () (k 'answered)))
+                                      (set! break   (lambda () (k 'hit-max)))
+                                      (run-mcat))))
+                  (answers (tell *memory* 'get-answers))
+                  ;; add-answer-description conses onto the front
+                  ;; (memory.ss:104), so a longer list means this run's answer
+                  ;; is at the head. Equal length means the run answered with
+                  ;; something memory already held.
+                  (found (if (> (length answers) n-before) (car answers) #f)))
+             (emit-row sidx sname ridx seed
+                       initial modified target (if answer answer "")
+                       *codelet-count* *temperature* outcome
+                       (if found (tell found 'get-answer-print-name) "")
+                       (if found (tell found 'get-quality) "")))))
+       (batch
+         '(
+{batch_literals}
+          ))
+       (walk
+         (lambda (rows current)
+           (if (not (null? rows))
+               (let* ((row (car rows)) (sidx (car row)))
+                 ;; Memory is cleared when the session index changes, never
+                 ;; inside a session.
+                 (if (not (= sidx current)) (tell *memory* 'clear))
+                 (apply run-one row)
+                 (walk (cdr rows) sidx))))))
+      (walk batch -1)))
+  'truncate)
+(exit)
+"""
+
+
+def ensure_display(display):
+    env = dict(os.environ, DISPLAY=display)
+    if subprocess.run(["xdpyinfo"], env=env, capture_output=True).returncode == 0:
+        return env
+    lock = f"/tmp/.X{display.lstrip(':')}-lock"
+    if os.path.exists(lock):
+        os.remove(lock)
+    subprocess.Popen(
+        ["Xvfb", display, "-screen", "0", "1280x1024x24", "-nolisten", "tcp"],
+        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
+    )
+    for _ in range(40):
+        if subprocess.run(["xdpyinfo"], env=env, capture_output=True).returncode == 0:
+            return env
+        time.sleep(0.5)
+    sys.exit(f"error: Xvfb never came up on {display}")
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__,
+                                 formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("spec", help="batch JSON file")
+    ap.add_argument("-o", "--out", default="/metacat/batch-out", help="output directory")
+    ap.add_argument("--display", default=os.environ.get("SOLVE_DISPLAY", ":98"))
+    args = ap.parse_args()
+
+    with open(args.spec) as fh:
+        spec = json.load(fh)
+    rows = build_runs(spec)
+    n_sessions = len({r["session"] for r in rows})
+
+    os.makedirs(args.out, exist_ok=True)
+    results_path = os.path.join(args.out, "results.tsv")
+    script_path = os.path.join(args.out, "batch.ss")
+
+    with open(script_path, "w") as fh:
+        fh.write(generate_scheme(rows, results_path))
+
+    print(f"{len(rows)} runs across {n_sessions} sessions "
+          f"({n_sessions} memory resets)", flush=True)
+    print(f"loading Metacat (~45s), then running; progress in {results_path}",
+          flush=True)
+
+    env = ensure_display(args.display)
+    started = time.time()
+    # SWL's installer writes /usr/local/bin/swl without a shebang, so it is only
+    # executable via a shell -- exec() on it fails with "Exec format error".
+    swl = shutil.which("swl") or "/usr/local/bin/swl"
+    proc = subprocess.run(["sh", swl, script_path],
+                          env=env, capture_output=True, text=True)
+    elapsed = time.time() - started
+
+    parsed, malformed = [], 0
+    if os.path.exists(results_path):
+        with open(results_path) as fh:
+            for line in fh:
+                line = line.rstrip("\n")
+                if not line:
+                    continue
+                parts = line.split("\t")
+                if len(parts) == len(FIELDS):
+                    parsed.append(dict(zip(FIELDS, parts)))
+                else:
+                    malformed += 1
+    if malformed:
+        print(f"WARNING: {malformed} malformed result line(s) "
+              f"(expected {len(FIELDS)} tab-separated fields)", file=sys.stderr)
+
+    if len(parsed) < len(rows):
+        print(f"WARNING: {len(parsed)} of {len(rows)} runs completed. "
+              f"swl exit {proc.returncode}.", file=sys.stderr)
+        tail = (proc.stdout or "").strip().splitlines()[-15:]
+        if tail:
+            print("--- swl output ---", file=sys.stderr)
+            print("\n".join(tail), file=sys.stderr)
+
+    for row in parsed:
+        row["problem"] = f"{row['initial']}->{row['modified']}; {row['target']}"
+
+    with open(os.path.join(args.out, "report.csv"), "w", newline="") as fh:
+        w = csv.DictWriter(fh, fieldnames=CSV_FIELDS)
+        w.writeheader()
+        w.writerows(parsed)
+    with open(os.path.join(args.out, "results.jsonl"), "w") as fh:
+        for row in parsed:
+            fh.write(json.dumps(row) + "\n")
+
+    print(f"\n{len(parsed)} runs in {elapsed:.0f}s "
+          f"({elapsed / max(len(parsed), 1):.1f}s per run)\n")
+    header = f"{'sess':>4} {'run':>4} {'seed':>11} {'problem':<26} " \
+             f"{'codelets':>9} {'temp':>5} {'result':<10}"
+    print(header)
+    print("-" * len(header))
+    for row in parsed[:40]:
+        problem = f"{row['initial']}->{row['modified']}; {row['target']}"
+        result = row["result"] or f"({row['outcome']})"
+        print(f"{row['session']:>4} {row['run']:>4} {row['seed']:>11} "
+              f"{problem:<26} {row['codelets']:>9} {row['final_temp']:>5} "
+              f"{result:<10}")
+    if len(parsed) > 40:
+        print(f"... {len(parsed) - 40} more rows in {args.out}/report.csv")
+
+    sys.exit(0 if len(parsed) == len(rows) else 1)
+
+
+if __name__ == "__main__":
+    main()
