+#!/usr/bin/env python3
+"""
+Fill in an episode run's gaps, and rebuild episodes.json from the shard files.
+
+    docker compose exec metacat /metacat/docker/episodes_finish.py            # both
+    docker compose exec metacat /metacat/docker/episodes_finish.py --rebuild-only
+
+WHY THIS EXISTS. episodes.py fixes a problem's shard count when it launches, and
+shard s takes episodes s, s+K, s+2K... Once most episodes are done the survivors
+are stuck on those K processes, so a slow problem trickles out on 3 cores while
+21 sit idle. It is also how a killed or crashed run leaves a partial sample.
+
+This re-partitions whatever is still missing over as many processes as you like,
+then rebuilds the summary from every shard file present.
+
+WHY IT IS SAFE. An episode's index fully determines its seeds -- episode e run i
+uses start_seed + e*runs + i -- so an episode is identical whichever process runs
+it, and re-running one is a no-op rather than a distortion. Only episodes whose
+shard wrote their EP completion marker are ever read, so an episode interrupted
+mid-flight is redone rather than counted short. New work is written to
+shard_extra*.tsv alongside the originals; nothing existing is touched.
+
+Per-problem keys in an existing episodes.json that this script does not itself
+compute -- `build`, for instance, which records which side of a source fix a
+problem's data came from -- are carried forward rather than dropped.
+"""
+
+import argparse
+import glob
+import gzip
+import json
+import os
+import subprocess
+import sys
+from concurrent.futures import ThreadPoolExecutor
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from episodes import PROBLEMS, shard_scheme  # noqa: E402
+
+HERE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+DEFAULT_WORK = "/metacat/oracle/work/episodes"
+DEFAULT_JSON = "/metacat/oracle/raw/episodes.json"
+
+RUN_FIELDS = 13
+
+
+def read_shards(workdir):
+    """{episode: {run_index: record}} and the set of EP-completed episodes."""
+    episodes, complete = {}, set()
+    for path in sorted(glob.glob(os.path.join(workdir, "shard*.tsv"))):
+        for line in open(path):
+            parts = line.rstrip("\n").split("\t")
+            if parts[0] == "RUN" and len(parts) == RUN_FIELDS:
+                (_, ep, i, seed, state, codelets, temperature, quality,
+                 atemp, na, ns, acts, snags) = parts
+                episodes.setdefault(int(ep), {})[int(i)] = {
+                    "i": int(i), "seed": int(seed), "state": state,
+                    "codelets": int(codelets), "temperature": float(temperature),
+                    "quality": float(quality), "answer_temperature": float(atemp),
+                    "memory_answers": int(na), "memory_snags": int(ns),
+                    "activations": [
+                        {"answer": a.rsplit(":", 1)[0],
+                         "activation": float(a.rsplit(":", 1)[1])}
+                        for a in acts.split(",") if a],
+                    "snags": [s for s in snags.split(",") if s],
+                }
+            elif parts[0] == "EP":
+                complete.add(int(parts[1]))
+    return episodes, complete
+
+
+def missing(workdir, total, runs):
+    episodes, complete = read_shards(workdir)
+    done = {ep for ep in complete if len(episodes.get(ep, {})) == runs}
+    return sorted(set(range(total)) - done)
+
+
+# The generated shard walks a list of episode indices instead of a stride, which
+# is the only thing episodes.py's own shard cannot do.
+EXPLICIT_TAIL = """
+      (for-each one-episode '({episode_list}))
+      (emit "SHARDDONE")))
+  'truncate)
+(with-output-to-file "{done_path}" (lambda () (display "done")) 'truncate)
+(exit)
+"""
+
+
+def explicit_shard(problem, out_path, done_path, eps, cfg):
+    """episodes.py's shard, with its stride loop swapped for an explicit list."""
+    _, initial, modified, target = problem
+    base = shard_scheme(initial, modified, target, out_path, done_path,
+                        0, 1, 0, cfg["runs"], cfg["start_seed"], cfg["max_steps"])
+    head, sep, _ = base.partition("      ;; Shard s takes episodes")
+    if not sep:  # episodes.py changed shape; fail loudly rather than silently
+        raise RuntimeError("cannot splice shard_scheme -- its loop comment moved")
+    return head + EXPLICIT_TAIL.format(
+        episode_list=" ".join(str(e) for e in eps), done_path=done_path)
+
+
+def fill(job):
+    problem, workdir, eps, idx, cfg = job
+    name = problem[0]
+    script = os.path.join(workdir, f"shard_extra{idx}.ss")
+    out = os.path.join(workdir, f"shard_extra{idx}.tsv")
+    done = os.path.join(workdir, f"shard_extra{idx}.done")
+    with open(script, "w") as fh:
+        fh.write(explicit_shard(problem, out, done, eps, cfg))
+    env = dict(os.environ)
+    env.pop("DISPLAY", None)
+    log = open(os.path.join(workdir, f"shard_extra{idx}.log"), "w")
+    subprocess.run(["scheme", "-q", script], env=env, stdout=log, stderr=log)
+    return name, idx, len(eps)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("-w", "--work", default=DEFAULT_WORK)
+    ap.add_argument("--json", default=DEFAULT_JSON)
+    ap.add_argument("--carry-from", default=DEFAULT_JSON,
+                    help="file to carry unrecomputed per-problem keys from, "
+                         "such as `build`; independent of --json")
+    ap.add_argument("-e", "--episodes", type=int, default=500)
+    ap.add_argument("-r", "--runs", type=int, default=8)
+    ap.add_argument("--start-seed", type=int, default=100_000)
+    ap.add_argument("--max-steps", type=int, default=100_000)
+    ap.add_argument("-p", "--procs", type=int, default=20,
+                    help="processes to spread the missing episodes over")
+    ap.add_argument("--only")
+    ap.add_argument("--rebuild-only", action="store_true",
+                    help="skip filling gaps; just rebuild the summary")
+    args = ap.parse_args()
+
+    cfg = dict(runs=args.runs, start_seed=args.start_seed,
+               max_steps=args.max_steps)
+    problems = PROBLEMS
+    if args.only:
+        wanted = set(args.only.split(","))
+        problems = [p for p in PROBLEMS if p[0] in wanted]
+
