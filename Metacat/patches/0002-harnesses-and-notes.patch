+#!/usr/bin/env python3
+"""
+How complete are the reference sets, and how many spurious flags follow?
+
+    docker/check_saturation.py
+
+Pure post-processing of oracle/raw/ -- no Chez, no runs. Run it after
+re-sampling either data set, to see whether "the program under test produced
+something the reference never did" still means what ORACLE-USAGE.md says it
+means.
+
+THE NUMBER THAT MATTERS. f1/n is the Good-Turing missing-mass estimate: f1 is
+the number of members seen exactly once, n the sample size, and the ratio
+estimates the chance the next sample produces something never seen before.
+Multiply by the 100 tries a comparison run uses and you get the expected number
+of "novel" results per problem that are really just reference undersampling.
+
+The two sets are deliberately held to different standards:
+
+  single-run set    sampled by oracle.py until f1/n <= 1e-4, so a novel state is
+                    almost certainly a real change.
+  convergence set   NOT driven down. Novel convergence answers are a signal the
+                    research programme wants, and suppressing them would cost
+                    enormously more sampling. See ORACLE-USAGE.md.
+
+So a rising convergence f1/n is not a defect. It is the number to quote when
+weighing a flag, and this script keeps it honest.
+
+The trend columns show f1/n over growing subsamples, which says whether more
+sampling would still buy anything or whether the tail is simply long.
+"""
+
+import argparse
+import gzip
+import json
+import os
+import random
+from collections import Counter
+
+ANSWERLESS = {"*NONE*", "*CAP*"}
+N_TEST = 100
+HERE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+RAW = os.path.join(HERE, "oracle", "raw")
+
+
+def gt_ratio(counts):
+    n = sum(counts.values())
+    f1 = sum(1 for v in counts.values() if v == 1)
+    return (f1 / n) if n else 0.0
+
+
+def convergence_answer(runs):
+    for r in reversed(runs):
+        if r["state"] not in ANSWERLESS:
+            return r["state"]
+    return None
+
+
+def load_episodes():
+    p = os.path.join(RAW, "episodes.json")
+    if os.path.exists(p):
+        return json.load(open(p))
+    with gzip.open(p + ".gz", "rt") as fh:
+        return json.load(fh)
+
+
+def trend(members, sizes, trials, rng):
+    """f1/n over growing subsamples of an observation list."""
+    out = []
+    for s in sizes:
+        if s > len(members):
+            out.append(None)
+            continue
+        vals = [gt_ratio(Counter(rng.sample(members, s))) for _ in range(trials)]
+        out.append(sum(vals) / trials)
+    return out
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--trials", type=int, default=40)
+    args = ap.parse_args()
+    rng = random.Random(20260806)
+
+    single = json.load(open(os.path.join(RAW, "single-runs.json")))
+    episodes = load_episodes()
+
+    print("SINGLE-RUN SETS -- oracle.py's stop rule is f1/n <= 1e-4\n")
+    print(f"{'problem':12s} {'n':>7} {'distinct':>9} {'f1/n':>9} "
+          f"{'stop reason':>14} {'spurious/100':>13}")
+    # Three problems stopped before the target and say so in stop_reason:
+    # checkpoint (hit the run ceiling with the set still growing) and
+    # shards_exited (stopped by hand). Those are recorded decisions, not faults.
+    # A problem claiming `saturated` while sitting above the target would be a
+    # real inconsistency, and is the only thing worth failing on.
+    inconsistent, stopped_early = [], []
+    for r in single["results"]:
+        ratio = r["f1"] / r["n"]
+        mark = ""
+        if ratio > 1e-4:
+            if r["stop_reason"] == "saturated":
+                inconsistent.append(r["name"])
+                mark = "   INCONSISTENT"
+            else:
+                stopped_early.append(r["name"])
+                mark = "   above target, stopped early by design"
+        print(f"{r['name']:12s} {r['n']:>7} {r['distinct_states']:>9} "
+              f"{ratio:9.5f} {r['stop_reason']:>14} {ratio * N_TEST:13.2f}{mark}")
+
+    print("\n\nCONVERGENCE SETS -- deliberately not driven to 1e-4\n")
+    sizes = [100, 200, 300, 400, 500]
+    print(f"{'problem':12s} {'episodes':>8} {'distinct':>9} "
+          + " ".join(f"{s:>7}" for s in sizes) + f" {'spurious/100':>13}")
+    total = 0.0
+    for r in episodes["results"]:
+        finals = []
+        for s in r["sequences"]:
+            a = convergence_answer(s["runs"])
+            if a is not None:
+                finals.append(a)
+        counts = Counter(finals)
+        ratio = gt_ratio(counts)
+        total += ratio * N_TEST
+        row = trend(finals, sizes, args.trials, rng)
+        cells = " ".join("      -" if v is None else f"{v:7.4f}" for v in row)
+        print(f"{r['name']:12s} {len(r['sequences']):>8} {len(counts):>9} "
+              f"{cells} {ratio * N_TEST:13.2f}")
+
+    print(f"\nExpected spurious novelty flags across all "
+          f"{len(episodes['results'])} problems per {N_TEST}-episode "
+          f"comparison: {total:.1f}")
+    print("A falling trend means more episodes would still shrink the tail; a "
+          "flat one\nmeans the tail is long and sampling will not close it "
+          "cheaply.")
+    if stopped_early:
+        print(f"\nAbove the 1e-4 target but stopped early on purpose: "
+              f"{', '.join(stopped_early)}.\nStill worth 0.04 or fewer spurious "
+              "flags per 100 runs. Extend with oracle.py --resume\nif a novelty "
+              "flag on one of them ever needs to carry more weight.")
+    if inconsistent:
+        print(f"\nWARNING: {', '.join(inconsistent)} claim `saturated` yet sit "
+              "above 1e-4.\nThat should not happen -- oracle.py's stop rule and "
+              "this check disagree.")
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
