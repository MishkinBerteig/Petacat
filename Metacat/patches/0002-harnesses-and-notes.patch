+#!/usr/bin/env python3
+"""
+Episode benchmark: sample sessions rather than runs, to look for learning.
+
+    docker compose exec metacat /metacat/docker/episodes.py
+
+An EPISODE is a sequence of runs over the SAME problem in ONE session, with
+Episodic Memory carried forward from each run to the next. The single-run oracle
+(oracle.py) clears memory before every run precisely so that runs are
+independent; this harness does the opposite, and records the ordered sequence of
+results so the progression can be analysed.
+
+WHAT ACTUALLY CARRIES FORWARD. Only the contents of Episodic Memory. init-mcat
+(run.ss:185-238) resets everything else on every run -- it reseeds the RNG,
+re-initialises the coderack, temperature, trace and themespace, rebuilds the
+workspace, and sends 'reset to every Slipnet node (run.ss:202-203). Of memory it
+sends only 'clear-activations and 'unhighlight-all-answers (run.ss:212-213), NOT
+'clear. So `answer-descriptions' and `snag-descriptions' accumulate across an
+episode and nothing else does.
+
+HOW MEMORY FEEDS BACK INTO A RUN. Three sites, and all three key on the current
+problem's own strings, so memory only bites when the same problem recurs -- which
+is what an episode is:
+
+  answers.ss:982    the answer-finder fizzles if 'answer-present? says this exact
+                    (answer-letters, top rule, bottom rule) is already stored, so
+                    a result cannot be reported twice in one episode;
+  answers.ss:1162   a snag is only recorded if 'snag-present? says it is new;
+  answers.ss:290,304  'get-equivalent-snag links an answer to a remembered snag.
+
+Note what 'answer-present? compares (memory.ss:90-96): the same answer STRING
+reached by a DIFFERENT rule is not suppressed. So the rule matters, and this
+harness records enough to tell the two cases apart.
+
+Reminding is the fourth channel and the only one that is purely observational
+here: 'add-answer-description 'compare's each new answer against every answer
+already stored (memory.ss:102-103) and sets their activations by distance
+(memory.ss:209-227, %distance-threshold% = 5). In GUI mode that produces
+commentary. Nothing in the engine reads those activations back, and init-mcat
+zeroes them, so they are captured at the end of each run instead.
+
+SEEDS. init-mcat calls (random-seed seed) unconditionally, so every run must be
+given one and no run inherits the previous run's RNG state. Episode e of a
+problem uses seeds S, S+1, ... S+R-1 where S = start-seed + e*R, matching
+oracle.py's own use of consecutive seeds. Two consequences worth holding on to:
+every individual run is independently reproducible from its own seed, and the
+ONLY thing distinguishing run i of an episode from a lone single run with the
+same seed is the memory it inherited. That is what isolates the learning effect.
+
+SHARDING. Runs inside an episode are strictly sequential and cannot be split.
+Episodes are independent, so shard s takes episodes s, s+K, s+2K, ...
+"""
+
+import argparse
+import json
+import os
+import shutil
+import subprocess
+import sys
+import time
+from concurrent.futures import ThreadPoolExecutor, as_completed
+
+EPISODES = 500       # episodes per problem
+RUNS = 8             # runs per episode
+MAX_STEPS = 100_000  # per-run codelet cap, same as oracle.py
+
+# Clear of the single-run oracle, which seeds every problem from 1 and reached
+# 51,000 runs on its longest (fig5.4-top, eqe-baaab). Starting here keeps every
+# episode run on a seed the oracle never used, so no run in this sample is a
+# repeat of one already in oracle.json.
+START_SEED = 100_000
+
+PROBLEMS = [
+    ("misc4",       "a",     "b",       "z"),
+    ("fig5.7",      "aabc",  "aabd",    "ijkk"),
+    ("misc3",       "abc",   "aabbcc",  "kkjjii"),
+    ("misc5",       "abc",   "abd",     "glz"),
+    ("misc2",       "abc",   "abd",     "ijk"),
+    ("run1",        "abc",   "abd",     "mrrjjj"),
+    ("run4",        "abc",   "abd",     "xyz"),
+    ("misc1",       "abc",   "cba",     "mrrjjj"),
+    ("fig5.4-top",  "eeqee", "qeeq",    "xxixx"),
+    ("eqe-baaab",   "eqe",   "qeq",     "abbba"),
+    ("run6",        "eqe",   "qeq",     "abbbc"),
+    ("run3",        "rst",   "rsu",     "xyz"),
+    ("run2",        "xqc",   "xqd",     "mrrjjj"),
+    ("copy1",       "ab",    "c",       "ab"),
+    ("copy2",       "bc",    "d",       "bc"),
+    ("copy3",       "xy",    "z",       "xy"),
+    ("copy4",       "zy",    "x",       "zy"),
+    ("copy5",       "aabb",  "cc",      "aabb"),
+    ("copy6",       "abc",   "d",       "abc"),
+]
+
+# Field separator for the per-run records. Chosen because no answer print name,
+# rule phrase or state token can contain it.
+SEP = "\\t"
+
+
+def shard_scheme(initial, modified, target, out_path, done_path,
+                 shard, nshards, episodes, runs, start_seed, max_steps):
+    """One shard: its slice of the episode list, each episode run start to end.
+
+    Emits one RUN line per run and one EP line per completed episode. A shard
+    writes continuously and flushes per line, so a killed shard still leaves
+    every episode it had finished.
+    """
+    return f"""
+;; Performance mode: plain Chez, no SWL, no Tk, no X display, no (setup).
+(define *metacat-directory* "/metacat/")
+(load "/metacat/metacat-headless.ss")
+
+(with-output-to-file "{out_path}"
+  (lambda ()
+    (letrec
+      ((emit (lambda args
+               (display (apply format args))
+               ;; write-char, not (newline): Metacat rebinds newline to the port
+               ;; captured at load time (syntactic-sugar.ss:32).
+               (write-char #\\newline)
+               (flush-output-port (current-output-port))))
+       ;; "a:87,b:0" -- every answer currently in memory with its activation.
+       ;; Captured after the run, before the next init-mcat zeroes them
+       ;; (run.ss:212). The newest answer sits at 100; the others carry the
+       ;; reminding strength that answer produced in them (memory.ss:209-227).
+       (activation-list
+         (lambda ()
+           (let loop ((a (tell *memory* 'get-answers)) (acc ""))
+             (if (null? a)
+                 acc
+                 (loop (cdr a)
+                       (string-append acc (if (string=? acc "") "" ",")
+                                      (tell (car a) 'get-answer-print-name) ":"
+                                      (number->string
+                                        (exact->inexact
+                                          (tell (car a) 'get-activation)))))))))
+       (snag-list
+         (lambda ()
+           (let loop ((s (tell *memory* 'get-snags)) (acc ""))
+             (if (null? s)
+                 acc
+                 (loop (cdr s)
+                       (string-append acc (if (string=? acc "") "" ",")
+                                      (tell (car s) 'print-name)))))))
+       ;; One run inside an episode. Memory is NOT cleared -- that is the point.
+       ;;
+       ;; The stopping state CANNOT be read the way oracle.py reads it. There,
+       ;; memory is empty at the start of every run, so "memory holds an answer"
+       ;; means "this run answered". Here memory is non-empty from run 1 onward.
+       ;; Nor is the continuation enough on its own: give-up calls (suspend) too
+       ;; (answers.ss:86-92), so 'answered covers both outcomes. What separates
+       ;; them is whether the run ADDED an answer -- abstract-answer-description
+       ;; stores it immediately before (suspend) at answers.ss:80-81 -- so the
+       ;; answer count is compared across the run.
+       (one-run
+         (lambda (ep i seed)
+           (let ((n-before (length (tell *memory* 'get-answers))))
+             (init-mcat '{initial} '{modified} '{target} #f seed)
+             (set! *break-time* {max_steps})
+             (let* ((outcome (call/cc (lambda (k)
+                                        (set! suspend (lambda () (k 'answered)))
+                                        (set! break   (lambda () (k 'capped)))
+                                        (run-mcat))))
+                    (answers (tell *memory* 'get-answers))
+                    (answered? (> (length answers) n-before))
+                    (newest (if answered? (car answers) #f)))
+               ;; episode, run index, seed, state, codelets, final temperature,
+               ;; answer quality, answer temperature, #answers, #snags,
+               ;; activations, snags.
+               ;;
+               ;; exact->inexact on every number: Metacat computes quality and
+               ;; temperature with exact arithmetic, so these can be rationals,
+               ;; and ~a would print one as "173/2" -- which no numeric parser on
+               ;; the other side accepts.
+               (emit "RUN{SEP}~a{SEP}~a{SEP}~a{SEP}~a{SEP}~a{SEP}~a{SEP}~a{SEP}~a{SEP}~a{SEP}~a{SEP}~a{SEP}~a"
+                 ep i seed
+                 (cond
+                   (answered? (tell newest 'get-answer-print-name))
+                   ((eq? outcome 'capped) "*CAP*")
+                   (else "*NONE*"))
+                 *codelet-count*
+                 (exact->inexact *temperature*)
+                 (if answered? (exact->inexact (tell newest 'get-quality)) -1.0)
+                 (if answered? (exact->inexact (tell newest 'get-temperature)) -1.0)
+                 (length answers)
+                 (length (tell *memory* 'get-snags))
+                 (activation-list)
+                 (snag-list))))))
+       (one-episode
+         (lambda (ep)
+           ;; A fresh session: this is the only 'clear in the harness.
+           (tell *memory* 'clear)
+           (let ((start (+ {start_seed} (* ep {runs}))))
+             (let loop ((i 0))
+               (if (< i {runs})
+                   (begin (one-run ep i (+ start i)) (loop (+ i 1))))))
+           (emit "EP{SEP}~a" ep))))
+
+      ;; Shard s takes episodes s, s+K, s+2K, ...
+      (let loop ((ep {shard}))
+        (if (< ep {episodes})
+            (begin (one-episode ep) (loop (+ ep {nshards})))))
+      (emit "SHARDDONE")))
+  'truncate)
+(with-output-to-file "{done_path}" (lambda () (display "done")) 'truncate)
+(exit)
+"""
+
+
+def read_shard(path):
+    """Parse a shard's TSV into {episode: [run-record, ...]} plus a done flag."""
+    episodes, complete, done = {}, set(), False
+    if not os.path.exists(path):
+        return episodes, complete, done
+    with open(path) as fh:
+        for line in fh:
+            parts = line.rstrip("\n").split("\t")
+            if parts[0] == "RUN" and len(parts) == 13:
+                (_, ep, i, seed, state, codelets, temperature, quality,
+                 answer_temperature, n_answers, n_snags, activations,
+                 snags) = parts
+                episodes.setdefault(int(ep), []).append({
+                    "i": int(i),
+                    "seed": int(seed),
+                    "state": state,
+                    "codelets": int(codelets),
+                    "temperature": float(temperature),
+                    # float, not int: the emitter sends these through
+                    # exact->inexact because Metacat computes quality with exact
+                    # arithmetic and ~a would otherwise print a rational.
+                    "quality": float(quality),
+                    "answer_temperature": float(answer_temperature),
+                    "memory_answers": int(n_answers),
+                    "memory_snags": int(n_snags),
+                    "activations": [
+                        {"answer": a.rsplit(":", 1)[0],
+                         "activation": float(a.rsplit(":", 1)[1])}
+                        for a in activations.split(",") if a
+                    ],
+                    "snags": [s for s in snags.split(",") if s],
+                })
+            elif parts[0] == "EP":
+                complete.add(int(parts[1]))
+            elif parts[0] == "SHARDDONE":
+                done = True
+    return episodes, complete, done
+
+
+def run_problem(job):
+    idx, problem, outdir, cfg = job
+    name, initial, modified, target = problem
+    workdir = os.path.join(outdir, name)
+    shutil.rmtree(workdir, ignore_errors=True)
+    os.makedirs(workdir, exist_ok=True)
+
+    k = min(cfg["shards"], cfg["episodes"])
+    procs = []
+    for s in range(k):
+        script = os.path.join(workdir, f"shard{s}.ss")
+        out = os.path.join(workdir, f"shard{s}.tsv")
+        done = os.path.join(workdir, f"shard{s}.done")
+        with open(script, "w") as fh:
+            fh.write(shard_scheme(initial, modified, target, out, done,
+                                  s, k, cfg["episodes"], cfg["runs"],
+                                  cfg["start_seed"], cfg["max_steps"]))
+        # Plain Chez: no swl, no display. DISPLAY is cleared so nothing can
+        # quietly reach for an X server.
+        env = dict(os.environ)
+        env.pop("DISPLAY", None)
+        # Captured rather than discarded: a bad message send prints "Ooops" and
+        # (reset)s, which kills a shard silently.
+        log = open(os.path.join(workdir, f"shard{s}.log"), "w")
+        procs.append(subprocess.Popen(["scheme", "-q", script],
+                                      env=env, stdout=log, stderr=log))
+
+    started = time.time()
+    for p in procs:
+        p.wait()
+
+    episodes, complete, shards_done = {}, set(), 0
+    for s in range(k):
+        eps, done_eps, done = read_shard(os.path.join(workdir, f"shard{s}.tsv"))
+        episodes.update(eps)
+        complete |= done_eps
+        shards_done += 1 if done else 0
+
+    # An episode is only reported if its shard wrote its EP marker, so a
+    # truncated tail is dropped rather than silently analysed as a short episode.
+    kept = sorted(complete)
+    oops = []
+    for s in range(k):
+        logpath = os.path.join(workdir, f"shard{s}.log")
+        if os.path.exists(logpath):
+            oops += [ln.rstrip("\n") for ln in open(logpath)
+                     if "Ooops" in ln or "Exception" in ln]
+
+    return {
+        "name": name,
+        "problem": [name, initial, modified, target],
+        "episodes_requested": cfg["episodes"],
+        "episodes_complete": len(kept),
+        "runs_per_episode": cfg["runs"],
+        "shards": k,
+        "shards_finished": shards_done,
+        "errors": oops[:20],
+        "wall_s": round(time.time() - started, 1),
+        "sequences": [
+            {"episode": ep,
+             "start_seed": cfg["start_seed"] + ep * cfg["runs"],
+             "runs": sorted(episodes[ep], key=lambda r: r["i"])}
+            for ep in kept
+        ],
+    }
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("-o", "--out", default="/metacat/oracle/work/episodes",
+                    help="shard working directory")
+    ap.add_argument("--json", default="/metacat/oracle/raw/episodes.json",
+                    help="where the summary lands (raw data)")
+    ap.add_argument("-j", "--jobs", type=int, default=1,
+                    help="problems in flight at once (each uses --shards cores)")
+    ap.add_argument("-k", "--shards", type=int, default=10,
+                    help="episodes in flight per problem; capped at --episodes")
+    ap.add_argument("-e", "--episodes", type=int, default=EPISODES)
+    ap.add_argument("-r", "--runs", type=int, default=RUNS)
+    ap.add_argument("--start-seed", type=int, default=START_SEED)
+    ap.add_argument("--max-steps", type=int, default=MAX_STEPS)
+    ap.add_argument("--only")
+    args = ap.parse_args()
+
+    os.makedirs(args.out, exist_ok=True)
+    os.makedirs(os.path.dirname(args.json), exist_ok=True)
+    cfg = dict(shards=args.shards, episodes=args.episodes, runs=args.runs,
+               start_seed=args.start_seed, max_steps=args.max_steps)
+
+    problems = PROBLEMS
+    if args.only:
+        wanted = set(args.only.split(","))
+        problems = [p for p in PROBLEMS if p[0] in wanted]
+
+    total = len(problems) * args.episodes * args.runs
+    print(f"{len(problems)} problems x {args.episodes} episodes x {args.runs} "
+          f"runs = {total} runs, {min(args.shards, args.episodes)} shards each, "
+          f"{args.jobs} in flight, max_steps={args.max_steps}", flush=True)
+
+    jobs = [(i, p, args.out, cfg) for i, p in enumerate(problems)]
+    started = time.time()
+    done = []
+    # as_completed, not pool.map: map yields in submission order, so one slow
+    # problem hides the completion of every problem behind it and holds up the
+    # incremental episodes.json with it. That happened on the oracle run, where
+    # misc3 sat at index 2 and masked sixteen finished problems for hours.
+    # Reported as they land; written to disk in problem order.
+    with ThreadPoolExecutor(max_workers=args.jobs) as pool:
+        futures = {pool.submit(run_problem, j): j[0] for j in jobs}
+        for fut in as_completed(futures):
+            res = fut.result()
+            done.append((futures[fut], res))
+            flag = "" if not res["errors"] else f"  {len(res['errors'])} ERRORS"
+            print(f"  DONE {res['name']:<12} "
+                  f"episodes={res['episodes_complete']}/{res['episodes_requested']} "
+                  f"({res['wall_s']}s){flag}   [{len(done)}/{len(jobs)}]",
+                  flush=True)
+            ordered = [r for _, r in sorted(done, key=lambda t: t[0])]
+            with open(args.json, "w") as fh:
+                json.dump({"params": cfg, "results": ordered,
+                           "wall_s": round(time.time() - started, 1)}, fh, indent=2)
+
+    results = [r for _, r in sorted(done, key=lambda t: t[0])]
+    bad = [r["name"] for r in results
+           if r["errors"] or r["episodes_complete"] != r["episodes_requested"]]
+    print(f"\ntotal {time.time() - started:.0f}s -> {args.json}")
+    if bad:
+        print(f"INCOMPLETE OR ERRORED: {', '.join(bad)}")
+        sys.exit(1)
+
+
+if __name__ == "__main__":
+    main()
