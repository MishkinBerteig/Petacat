+;; tell as a macro rather than a procedure.
+;;
+;; A run of abc->abd;xyz at seed 42 makes 1,309,245 message sends -- 959 per
+;; codelet -- and the procedure form cost 199ns per send against 67ns for a
+;; direct closure application, because (lambda args ...) conses a rest list on
+;; every send and then applies the object to it. That overhead measured 32% of
+;; total runtime. Expanding to a direct call removes both the allocation and
+;; the apply.
+;;
+;; Semantics are identical: obj is still evaluated once, arguments still left
+;; to right, and an unhandled message still lands in report-error-and-halt with
+;; the same (object message ...) list it used to receive -- now built only on
+;; the error path. %tell-o% / %tell-r% are spelled that way because Chez's
+;; extend-syntax is not hygienic and there are 4,037 call sites; neither name
+;; appears anywhere else in the tree.
+(extend-syntax (tell)
+  ((tell obj m arg ...)
+   (let* ((%tell-o% obj)
+	  (%tell-r% (%tell-o% %tell-o% m arg ...)))
+     (if (eq? %tell-r% 'invalid-message-indicator)
+       (report-error-and-halt (list %tell-o% m arg ...) %tell-o%)
+       %tell-r%))))
