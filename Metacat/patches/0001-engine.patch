+;;-----------------------------------------------------------------------------
+;; Three "graphics" procedures that are not graphics at all -- pure functions
+;; that engine files call unguarded. Copied verbatim so behaviour is identical.
+
+;; theme-graphics.ss:741, called from trace.ss:1490 (print-pattern), which is
+;; reached from five places in trace.ss whenever a themespace pattern is
+;; printed. Returns a string used in a printf ~a, so it must be real.
+;; The plato-* nodes are slipnet objects defined later; referencing them inside
+;; the lambda body rather than at load time is what makes that safe.
+(define relation-name
+  (lambda (relation)
+    (cond
+      ((eq? relation #f) "diff")
+      ((eq? relation plato-identity) "iden")
+      ((eq? relation plato-opposite) "opp")
+      ((eq? relation plato-successor) "succ")
+      ((eq? relation plato-predecessor) "pred")
+      (else #f))))
+
+;; general-graphics.ss:549, called from rules.ss:1739
+(define find-next-space-position
+  (lambda (s i)
+    (cond
+      ((>= i (string-length s)) (string-length s))
+      ((char=? (string-ref s i) #\space) i)
+      (else (find-next-space-position s (+ i 1))))))
+
+;; trace-graphics.ss:322, called from trace.ss:841
+(define group-event-pexp-text-string
+  (lambda (group)
+    (let* ((bond-facet (tell group 'get-bond-facet))
+	   (constituent-objects (tell group 'get-constituent-objects))
+	   (descriptors (tell-all constituent-objects 'get-descriptor-for bond-facet))
+	   (descriptor-strings
