+(define %text-scroll-pause% 0)
+(define %codelet-highlight-pause% 0)
+(define %flash-pause% 0)
+(define %snag-pause% 0)
+(define %num-of-flashes% 0)
+
+;; slipnet-graphics.ss:164, theme-graphics.ss:25 -- read by setup.ss only
+(define *13x5-layout-table* '())
+(define *themespace-window-layout* '())
+
