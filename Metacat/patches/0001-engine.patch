+;;=============================================================================
+;; Headless (performance mode) support for Metacat.
+;;
+;; Not part of James B. Marshall's original distribution.
+;;
+;; Metacat has exactly two modes:
+;;
+;;   %gui-mode% #t   load metacat.ss          the original program, unchanged
+;;   %gui-mode% #f   load metacat-headless.ss engine only, no SWL, no Tk, no X
+;;
+;; In performance mode none of the sixteen GUI files are loaded and (setup) is
+;; never called, so no window, font, colour or canvas object is ever created.
+;; Everything the engine reaches for is supplied here instead: a null object
+;; that swallows every message, stubs for the handful of drawing procedures the
+;; engine calls directly, and plain values for the fonts, colours and layout
+;; tables it reads.
+;;
+;; This file must be loaded AFTER utilities.ss (it uses tell) and BEFORE
+;; constants.ss (which calls swl-font at load time). Call install-headless!
+;; once every engine file is loaded; it points the window globals at the null
+;; object.
+;;
+;; Why a null object rather than the %...-graphics% flags: the flags only guard
+;; part of the tree. themes.ss has no graphics guard at all, and trace.ss,
+;; memory.ss and answers.ss all draw unconditionally. Leaving one real window
+;; behind is also what caused Metacat to slow to a crawl over a few hundred
+;; runs -- its windows retag canvas items as garbage and rely on a later
+;; 'garbage-collect that run-mcat only ever sends to two of them.
+;;=============================================================================
+
+;;-----------------------------------------------------------------------------
+;; The null window.
+;;
+;; Answers 'done to anything by default. The handful of messages whose return
+;; value an engine file actually consumes get a value of the right shape; all
+;; of them sit behind %workspace-graphics% or a GUI click handler, so the
+;; values are never used for anything in performance mode -- they exist so that
+;; arithmetic does not meet 'done if some path is reached unexpectedly.
+
+(define make-null-window
+  (lambda ()
+    (lambda msg
+      (let ((message (2nd msg)))
+	(case message
+	  ;; setup.ss:61-63 stores these; nothing reads them
+	  ((get-window) (make-null-window))
+	  ;; setup.ss:152,158 verbose-on/verbose-off
+	  ((verbose-mode?) %verbose%)
+	  ;; trace.ss:514,1252 -- reachable only by clicking an event icon
+	  ((get-cached-pexp) '(let-sgl ()))
+	  ;; groups.ss:170-192, bridges.ss:516-520 -- behind %workspace-graphics%
+	  ((get-character-width get-character-height get-string-height
+	    get-string-width get-visible-w get-visible-h get-width get-height
+	    get-spanning-vertical-bridge-right-x get-spanning-cm-list-offset)
+	   0)
+	  ((get-character-bounding-box) '((0 0) (0 0)))
+	  ((get-cm-list-coord) '(0 0))
+	  ((object-type) 'null-window)
+	  (else 'done))))))
+
+(define *null-window* (make-null-window))
+
+;;-----------------------------------------------------------------------------
+;; The null MEMORY window.
+;;
+;; The plain null window is not enough here, and the difference only shows up
+;; once Episodic Memory is non-empty -- which no single-run harness ever does,
+;; because it clears memory before every run.
+;;
+;; An answer-description holds `get-normal-icon-pexp' as a local variable
+;; containing a PROCEDURE of one argument, initialised to #f (memory.ss:131) and
+;; installed only by 'set-graphics-info, which only the real memory window's
+;; 'add-memory-icon ever sends (memory-graphics.ss:115-116). Leave it #f and
+;; three methods apply it:
+;;
+;;   update-activation   memory.ss:201-206   (get-normal-icon-pexp new-value)
+;;   get-normal-icon-pexp memory.ss:232      (get-normal-icon-pexp activation)
+;;   unhighlight         memory.ss:260-264   (get-normal-icon-pexp activation)
+;;
+;; so the run dies with "attempt to apply non-procedure #f". It is reached on
+;; the *second* run of any session whose first run produced an answer:
+;; add-answer-description sets the new answer's activation to 100
+;; (memory.ss:100), and the next init-mcat sends 'clear-activations
+;; (run.ss:212), which sends 'update-activation 0 to it -- a changed value, so
+;; the draw fires. Within a single run it is reached as soon as a second answer
+;; is stored, because add-answer-description 'compare's it against each answer
+;; already held (memory.ss:102-103) and compare updates their activations.
+;;
+;; Snag descriptions are unaffected: theirs is a plain value that is only ever
+;; passed to 'draw, never applied (memory.ss:344, 371, 376).
+;;
+;; So this window answers 'add-memory-icon by installing a pexp procedure of the
+;; right shape that draws nothing. Marshall's files are untouched; supplying a
+;; GUI dependency as a no-op is what this file is for.
+
+(define make-null-memory-window
+  (lambda ()
+    (lambda msg
+      (let ((message (2nd msg)))
+	(case message
+	  ((add-memory-icon)
+	   (let ((answer (3rd msg)))
+	     ;; Same two arguments the real window supplies: a procedure taking an
+	     ;; activation and returning a pexp, and a highlight pexp. Both are
+	     ;; only ever drawn, and drawing here is a no-op.
+	     (tell answer 'set-graphics-info
+	       (lambda (activation) '(let-sgl ()))
+	       '(let-sgl ()))
+	     (tell answer 'set-bounding-box 0 0 0 0)
+	     'done))
+	  ((object-type) 'memory-window)
+	  (else 'done))))))
+
+(define *null-memory-window* (make-null-memory-window))
+
+(define install-headless!
+  (lambda ()
+    (set! *workspace-window* *null-window*)
+    (set! *slipnet-window* *null-window*)
+    (set! *coderack-window* *null-window*)
+    (set! *themespace-window* *null-window*)
+    (set! *top-themes-window* *null-window*)
+    (set! *bottom-themes-window* *null-window*)
+    (set! *vertical-themes-window* *null-window*)
+    ;; Not *null-window*: see make-null-memory-window above. Episodic Memory is
+    ;; the one thing that survives init-mcat, so a session of several runs over
+    ;; the same problem reaches code the single-run harnesses never do.
+    (set! *memory-window* *null-memory-window*)
+    (set! *comment-window* *null-window*)
+    (set! *trace-window* *null-window*)
+    (set! *temperature-window* *null-window*)
+    (set! *EEG-window* *null-window*)
+    (set! *control-panel* *null-window*)
+    ;; The EEG recorder itself is pure Scheme (a ring buffer of thunk values),
+    ;; but it is defined in eeg-graphics.ss, which is not loaded.
+    (set! *EEG* *null-window*)
+    ;; Drawing is off. These are Metacat's own flags; the engine consults them
+    ;; in about sixty places to decide whether to build graphics at all, and
+    ;; leaving them on would mean constructing picture-expressions to hand to a
+    ;; window that discards them.
+    (set! %workspace-graphics% #f)
+    (set! %slipnet-graphics% #f)
+    (set! %coderack-graphics% #f)
+    (set! %codelet-count-graphics% #f)
+    (set! %highlight-last-codelet% #f)
+    (set! %nice-graphics% #f)
+    (set! %verbose% #f)
+    ;; Each codelet type captures its window in a LOCAL (coderack.ss:81),
+    ;; which only coderack-graphics.ss ever sets. That local is not behind any
+    ;; graphics flag: coderack.ss:222 sends 'set-last-codelet-type to it on
+    ;; every codelet run, so left at #f the first codelet dies with "attempt to
+    ;; apply non-procedure #f". Give every codelet type the null window and
+    ;; harmless values for the rest.
+    ;; Argument order is coderack.ss:132
+    ;;   (g pexp get-urgency-pexp get-highlight-pexp coord x1 y1 y2 bar-proc)
+    (for-each
+      (lambda (codelet-type)
+	(tell codelet-type 'set-graphics-parameters
+	  *null-window*                  ;; g
+	  '(let-sgl ())                  ;; slot-pexp
+	  (lambda (urgency) '(let-sgl ()))
+	  (lambda (color) '(let-sgl ()))
+	  '(0 0)                         ;; codelet-count-coord
+	  0 0 0                          ;; bar-left, bar-bottom, bar-top
+	  (lambda (prob) 0)))            ;; bar-proc
+      *codelet-types*)
+    'done))
+
+;;-----------------------------------------------------------------------------
+;; SWL primitives the engine touches. Performance mode runs under plain Chez,
+;; where none of these exist.
+
+;; utilities.ss:926 pause -> thread-sleep. Nothing should be waiting for
+;; anything in performance mode, so time does not pass.
+(define thread-sleep (lambda (ms) 'done))
+(define thread-self (lambda () 'headless-thread))
+(define thread-kill (lambda args (exit 1)))
+(define thread-break (lambda (thread ignore thunk) (thunk)))
+(define swl:sync-display (lambda () 'done))
+(define swl:version "headless")
+(define swl:screen-width (lambda () 1280))
+(define swl:screen-height (lambda () 1024))
+(define swl:font-families (lambda () '()))
+(define swl:tcl-eval (lambda args 'done))
+
+;; run.ss:83 evaluates (waiter-prompt-and-read) at load time.
+(define waiter-prompt-and-read (lambda args 'done))
+(define waiter-prompt-string (lambda args 'done))
+
+;;-----------------------------------------------------------------------------
+;; Fonts and colours. constants.ss calls swl-font at load time; several engine
+;; files read font and colour values defined in the GUI files. Nothing in
+;; performance mode inspects them -- they are passed to drawing calls that go
+;; nowhere -- so a symbol is a sufficient value.
+
+(define swl-font (lambda (face size . style) 'headless-font))
+(define serif 'headless-serif)
+(define sans-serif 'headless-sans-serif)
+(define fancy 'headless-fancy)
+
+;; general-graphics.ss:24,28
+(define %default-fg-color% 'headless-black)
+(define *fg-color* %default-fg-color%)
+
+;; workspace-graphics.ss:41-44, read by groups.ss:171-205
+(define %group-letter-category-font% 'headless-font)
+(define %relevant-group-length-font% 'headless-font)
+;; coderack-graphics.ss:33, read by coderack.ss:123
+(define %coderack-codelet-count-font% 'headless-font)
