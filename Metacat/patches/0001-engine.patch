+;;=============================================================================
+;; Metacat loader, performance mode.
+;;
+;; Not part of James B. Marshall's original distribution. metacat.ss is the
+;; other loader and remains the original program.
+;;
+;;   scheme --script run-a-problem.ss     (plain Chez -- no swl, no DISPLAY)
+;;
+;; Loads the engine and nothing else: none of the sixteen GUI files, no SWL
+;; imports, and no (setup). headless.ss supplies every GUI dependency as a
+;; no-op. See headless.ss for the reasoning.
+;;
+;; Set *metacat-directory* before loading this file if the source is not in the
+;; current directory.
+;;=============================================================================
+
+;; define-top-level-value, not define: a define is not valid in an expression
+;; context, and this has to be conditional so a caller can point us elsewhere.
+(if (not (top-level-bound? '*metacat-directory*))
+  (define-top-level-value '*metacat-directory*
+    (string-append (current-directory) "/")))
+
+(define *platform* 'linux)
+(define *file-dialog-directory* *metacat-directory*)
+(define *tcl/tk-version* 8.6)
+(define *tcl/tk-version-8_3?* #t)
+
+;; The mode switch. constants.ss reads it at load time; setup.ss and run.ss
+;; read it to skip everything Tk-shaped.
+(define %gui-mode% #f)
+
+(current-directory *metacat-directory*)
+
+(load "syntactic-sugar.ss")
+(load "utilities.ss")
+;; Before constants.ss: it calls swl-font at load time, and swl-font lives in
+;; fonts.ss, which is a GUI file.
+(load "headless.ss")
+(load "constants.ss")
+(load "setup.ss")
+(load "coderack.ss")
+(load "descriptions.ss")
+(load "bonds.ss")
+(load "groups.ss")
