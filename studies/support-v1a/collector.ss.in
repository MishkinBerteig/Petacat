(define *metacat-directory* "/metacat/")
(load "/metacat/metacat-headless.ss")
(set! report-error-and-halt
  (lambda (message object)
    (assertion-violation 'metacat-message "unrecognized object message" (cdr message))))
(reset-handler (lambda () (exit 1)))
(define output (open-output-file "/out/raw.tsv" 'error))
(define study-stage 'clear-memory)
(define (record-engine-error c i seed started)
  (let ((details (open-output-file "/out/condition.txt" 'error)))
    (write (list 'assertion (assertion-violation? c)
                 'error (error? c)
                 'who (if (who-condition? c) (condition-who c) #f)
                 'message (if (message-condition? c) (condition-message c) #f)
                 'irritants (if (irritants-condition? c) (condition-irritants c) '())) details)
    (write-char #\newline details)
    (close-output-port details))
  (let ((marker (open-output-file "/out/engine-error.tsv" 'error)))
    (display (format "~a\t~a\t~a\t~a\t~a"
                     i seed study-stage
                     (if (eq? study-stage 'run) *codelet-count* "unknown")
                     (- (real-time) started)) marker)
    (write-char #\newline marker)
    (close-output-port marker))
  (flush-output-port output)
  (exit 86))
(let loop ((i 0))
  (when (< i $count)
    (let ((started (real-time)) (seed (+ $first_seed i)))
      (let ((result
        (guard (c ((and (or (assertion-violation? c) (error? c))
                        (not (i/o-error? c))
                        (not (implementation-restriction-violation? c)))
                   (record-engine-error c i seed started)))
          (set! study-stage 'clear-memory)
          (tell *memory* 'clear)
          (set! study-stage 'initialize)
          (init-mcat '$initial '$modified '$target #f seed)
          (set! *break-time* $cap)
          (set! study-stage 'run)
          (let* ((outcome (call/cc (lambda (k)
                             (set! suspend (lambda () (k 'suspended)))
                             (set! break (lambda () (k 'capped)))
                             (run-mcat))))
                 (answers (tell *memory* 'get-answers))
                 (state (cond ((not (null? answers))
                                (tell (car answers) 'get-answer-print-name))
                              ((eq? outcome 'capped) "*CAP*")
                              (else "*NONE*"))))
            (list state *codelet-count* (- (real-time) started) outcome)))))
        (display (format "~a\t~a\t~a\t~a\t~a\t~a"
                         i seed (list-ref result 0) (list-ref result 1)
                         (list-ref result 2) (list-ref result 3)) output)
        (write-char #\newline output)
        (flush-output-port output)))
    (loop (+ i 1))))
(close-output-port output)
(exit 0)
