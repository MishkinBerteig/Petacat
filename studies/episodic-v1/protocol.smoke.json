    "consecutive_checkpoints": 2,
    "singleton_threshold": 0.1
  },
  "validation_episodes": 4,
  "port_episodes": 4,
  "seed_stride": 100000,
  "seed_bases": {"construction": 60000000, "validation": 70000000, "port": 80000000},
  "problems": [
    {"name": "misc4", "strings": ["a", "b", "z"]},
    {"name": "run4", "strings": ["abc", "abd", "xyz"]}
  ]
}
