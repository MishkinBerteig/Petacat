{
  "schema_version": 1,
  "study_id": "episodic-v1-smoke",
  "study_kind": "smoke",
  "population": "unordered-tied-answer-sets",
  "projections": ["quality", "preference"],
  "episode_runs": 8,
  "max_codelets": 100000,
  "backend": "numpy",
  "workers": 2,
  "episode_timeout_seconds": 300,
