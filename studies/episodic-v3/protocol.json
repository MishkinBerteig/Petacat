{
  "schema_version": 3,
  "study_id": "episodic-v3-capped-frozen-oracles",
  "study_kind": "main",
  "population": "individual-best-answer-conditional-on-answered-episode",
  "definitions": {"best_a": "quality", "best_b": "preference"},
  "tie_policy": "earliest-winning-occurrence-v1",
  "episode_runs": 8,
  "max_codelets": 100000,
  "backend": "numpy",
  "workers": 12,
  "episode_timeout_seconds": 300,
  "invocation_timeout_seconds": 43200,
  "construction": {
    "min_episodes": 1,
    "max_episodes": 2000,
    "checkpoint_every": 1,
    "singleton_threshold": 0.0001
  },
  "validation": {
    "episodes": 1000,
    "requires_both_thresholds": true,
    "missing_mass_target": 0.01,
    "family_alpha": 0.05,
    "family_size": 38,
    "method": "one-sided-exact-binomial-bonferroni",
    "fixed_sample_size": true
  },
  "port_episodes": 100,
  "port_frequency_inference": "descriptive-only",
  "sampling": "independent-uniform-first-seeds-with-replacement",
  "pilot_reuse": "all-recorded-pilot-episodes-as-construction-prefix-no-retrospective-freezing",
  "problems": [
    {"name": "misc4", "strings": ["a", "b", "z"]},
    {"name": "fig5.7", "strings": ["aabc", "aabd", "ijkk"]},
    {"name": "misc3", "strings": ["abc", "aabbcc", "kkjjii"]},
    {"name": "misc5", "strings": ["abc", "abd", "glz"]},
    {"name": "misc2", "strings": ["abc", "abd", "ijk"]},
    {"name": "run1", "strings": ["abc", "abd", "mrrjjj"]},
    {"name": "run4", "strings": ["abc", "abd", "xyz"]},
    {"name": "misc1", "strings": ["abc", "cba", "mrrjjj"]},
    {"name": "fig5.4-top", "strings": ["eeqee", "qeeq", "xxixx"]},
    {"name": "eqe-baaab", "strings": ["eqe", "qeq", "abbba"]},
    {"name": "run6", "strings": ["eqe", "qeq", "abbbc"]},
    {"name": "run3", "strings": ["rst", "rsu", "xyz"]},
    {"name": "run2", "strings": ["xqc", "xqd", "mrrjjj"]},
    {"name": "copy1", "strings": ["ab", "c", "ab"]},
    {"name": "copy2", "strings": ["bc", "d", "bc"]},
    {"name": "copy3", "strings": ["xy", "z", "xy"]},
    {"name": "copy4", "strings": ["zy", "x", "zy"]},
    {"name": "copy5", "strings": ["aabb", "cc", "aabb"]},
