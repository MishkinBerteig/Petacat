# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# Node
node_modules/
.vite/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Per-developer agent tooling.  Machine-local by construction — the profile points
# at a loopback endpoint and names whichever model that developer runs — and the
# `.local.json` suffix is the usual marker for "not shared".  A shared openclaude
# config, if one is ever wanted, would be `.openclaude/settings.json` and is not
# ignored here.
.openclaude-profile.json
.openclaude/settings.local.json

# Environment
.env
.env.local

# Native macOS development (WP2.1 — replaces the container stack)
.venv/
.venv-*/

# pytest
.pytest_cache/
htmlcov/
.coverage

# TypeScript incremental build cache
client/tsconfig.tsbuildinfo
client/dist/

# Seed-data copies taken before an export overwrites them
seed_data/.backups/
