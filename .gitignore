# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# Node
node_modules/
.vite/

# IDE
.vscode/
.idea/
*.swp
*.swo

# macOS Finder metadata
.DS_Store

# Per-developer agent tooling.  Machine-local by construction — the profile points
# at a loopback endpoint and names whichever model that developer runs — and the
# `.local.json` suffix is the usual marker for "not shared".  A shared openclaude
# config, if one is ever wanted, would be `.openclaude/settings.json` and is not
# ignored here.
.openclaude-profile.json
.openclaude/settings.local.json

# Environment
.env
.env.local

# Native macOS development (WP2.1 — replaces the container stack)
.venv/
.venv-*/

# pytest
.pytest_cache/
htmlcov/
.coverage

# TypeScript incremental build cache
client/tsconfig.tsbuildinfo
client/dist/

# Seed-data copies taken before an export overwrites them
seed_data/.backups/

# Lockstep replay outputs (regenerated by scripts/lockstep_corpus.py)
tests/lockstep/replays/
# Only the abc->abd; xyz traces are committed; the rest of the corpus is regenerated
# by tests/lockstep/metacat/record.py (see tests/lockstep/metacat/README.md).
tests/lockstep/traces/*
!tests/lockstep/traces/abc-abd-xyz/
tests/lockstep/traces-heldout/

# Agents' working files (scripts, Metacat recordings, logs): kept on disk, never committed.
agents-workspace/

# Default output of the wrap-and-log recorders and sweeps (tests/lockstep/metacat/record_*.py,
# scripts/sweep_*.py): regenerated on demand.
tests/lockstep/out/
