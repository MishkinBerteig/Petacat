{
 "name": "training-v2",
 "title": "The Training Mode Base Configuration, v2.0",
 "ops": [
  {
   "op": "add_link_type",
   "name": "adjacent",
   "behaviour": "lateral",
   "display_label": "Adjacent",
   "description": "Two symbols seen side by side. The lateral behaviour, so concept mappings between letters read it. The v2.0 Base only. consolidator writes a link of this type for every pair of single symbols that an adjacent bond joined in the Workspace, labelled by plato-adjacent."
  },
  {
   "op": "add_node",
   "name": "plato-adjacent",
   "fields": {
    "short_name": "adjacent",
    "conceptual_depth": 45,
    "plain_name": "adjacent",
    "description": "Represents the bond type of adjacency, the relation between two neighbouring objects that no link relates (for example a and c, or 1 and 2). An instance of bond-category, beside successor and sameness. Its intrinsic link length is long, so an adjacent bond is weak until one is built and the category becomes fully active. The v2.0 Base only."
   },
   "links": [
    {
     "to": "plato-bond-category",
     "type": "category",
     "length": 30,
     "fixed": true
    },
    {
     "from": "plato-bond-category",
     "type": "instance",
     "length": 100,
     "fixed": true
    }
   ],
   "roles": [
    "bond_category.adjacent"
   ],
   "layout": {
    "grid_row": 1,
    "grid_col": 13
   }
  },
  {
   "op": "update",
   "table": "engine_params",
   "key": {
    "name": "intrinsic_link_lengths"
   },
   "patch": {
    "value": [
     {
      "op": "add",
      "path": "/plato-adjacent",
      "value": 90
     }
    ]
   }
  },
  {
   "op": "insert",
   "table": "theme_relations",
   "row": {
    "name": "adjacent",
    "node_name": "plato-adjacent",
    "abstractness": null,
    "description": "Neighbours that no other relation names. Abstractness is the node's conceptual depth. The v2.0 Base only.",
    "role": null
   }
  },
  {
   "op": "add_param",
   "name": "new_node_conceptual_depth",
   "to": 10,
   "value_type": "int"
  },
  {
   "op": "add_param",
   "name": "consolidation_threshold",
   "to": 40,
   "value_type": "int"
  },
  {
   "op": "add_param",
   "name": "adjacent_link_length",
   "to": 90,
   "value_type": "int"
  },
  {
   "op": "add_param",
   "name": "adjacent_link_step",
   "to": 0.125,
   "value_type": "float"
  },
  {
   "op": "add_param",
   "name": "symbol_category_link_length",
   "to": 20,
   "value_type": "int"
  },
  {
   "op": "add_param",
   "name": "symbol_instance_link_length",
   "to": 97,
   "value_type": "int"
  },
  {
   "op": "add_codelet_type",
   "name": "symbol-scout",
   "fields": {
    "family": "description",
    "phase": "scout",
    "description": "Notices a Letter object whose symbol has no letter-category description. If the symbol has a node it binds the object to it and proposes the ordinary description; if not it posts symbol-builder. The v2.0 Base only.",
    "source_file": null,
    "source_line": null,
    "execute_body": {
     "$file": "codelets/symbol-scout.py"
    }
   }
  },
  {
   "op": "add_codelet_type",
   "name": "symbol-builder",
   "fields": {
    "family": "description",
    "phase": "builder",
    "description": "Makes the Slipnet node for a symbol that has none, connected to nothing, with apply_ops, binds the object to it and proposes the ordinary description, and proposes the node as a trigger of consolidator's posting rule (effective from the next run). One add_node row per code point. The v2.0 Base only.",
    "source_file": null,
    "source_line": null,
    "execute_body": {
     "$file": "codelets/symbol-builder.py"
    }
   }
  },
  {
   "op": "add_codelet_type",
   "name": "consolidator",
   "fields": {
    "family": "meta",
    "phase": "other",
    "description": "One run is one noticing of the symbol node that triggered it. If the Workspace holds the symbol it proposes one more noticing, an adjacent link (adjacent_link_length, shortened by adjacent_link_step at every later noticing) for each adjacent bond between it and another single symbol, and, once its noticings reach consolidation_threshold, its category and instance links to the letter category (at symbol_category_link_length and symbol_instance_link_length) where they are missing. The v2.0 Base only.",
    "source_file": null,
    "source_line": null,
    "execute_body": {
     "$file": "codelets/consolidator.py"
    }
   }
  },
  {
   "op": "add_posting_rule",
   "rule_key": "symbol-scout",
   "fields": {
    "codelet_type": "symbol-scout",
    "direction": "bottom_up",
    "urgency_level": "low",
    "posting_formula": "1.0",
    "count_formula": "fixed",
    "count_values": {
     "fixed": 1
    },
    "condition": "num_unperceived_symbols > 0"
   }
  },
  {
   "op": "add_posting_rule",
   "rule_key": "consolidator",
   "fields": {
    "codelet_type": "consolidator",
    "direction": "top_down",
    "urgency_level": null,
    "urgency_formula": "round(activation / 2)",
    "posting_formula": "1.0",
    "count_formula": "fixed",
    "count_values": {
     "fixed": 1
    },
    "condition": "always",
    "triggering_slipnodes": []
   }
  },
  {
   "op": "add_trigger",
   "rule_key": "consolidator",
   "node": "plato-a"
  },
